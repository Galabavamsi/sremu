index 0000000000000000000000000000000000000000..5a38e547a27e43563add4ec12ef3be7b6b13fdfe
--- /dev/null
+++ b/bench/aws/pack_results.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Pack a job's result directory into a small tar.gz for the console channel (stdlib only).
+
+Usage::
+
+    python3 pack_results.py --in /opt/sremu/out --out results.tar.gz [--max-bytes 2000000]
+
+Included: every file under ``--in`` except ``dirty.patch`` files larger than
+``--max-patch-bytes`` (their SHA-256 is still listed) and files matching ``--exclude``
+globs. If the compressed archive exceeds ``--max-bytes`` (default 2 MB, the console budget),
+the largest non-essential files are dropped one by one (``manifest.json``, ``meta.json``,
+``summary.json``, ``spec.json``, ``status.json`` and ``*.log`` tails are kept) until it
+fits. ``PACK_INDEX.json`` (in the archive) lists every file with its size, SHA-256 and
+whether it was included or why it was dropped. The archive is deterministic for a given
+set of file contents (sorted entries, fixed mtime/uid/gid, gzip mtime 0).
+"""
+
+from __future__ import annotations
+
+import argparse
+import fnmatch
+import gzip
+import hashlib
+import io
+import json
+import sys
+import tarfile
+from pathlib import Path
+
+ESSENTIAL = (
+    "manifest.json",
+    "meta.json",
+    "summary.json",
+    "spec.json",
+    "status.json",
+    "sysinfo.json",
+    "PACK_INDEX.json",
+)
+
+
+def _sha(b: bytes) -> str:
+    return hashlib.sha256(b).hexdigest()
+
+
+def build_archive(files: dict[str, bytes]) -> bytes:
+    """Deterministic tar.gz of ``{posix name: bytes}``."""
+    raw = io.BytesIO()
+    with tarfile.open(fileobj=raw, mode="w", format=tarfile.PAX_FORMAT) as tf:
+        for name in sorted(files):
+            data = files[name]
+            ti = tarfile.TarInfo(name)
+            ti.size = len(data)
+            ti.mtime = 0
+            ti.mode = 0o644
+            ti.uid = ti.gid = 0
+            ti.uname = ti.gname = ""
+            tf.addfile(ti, io.BytesIO(data))
+    out = io.BytesIO()
+    with gzip.GzipFile(fileobj=out, mode="wb", compresslevel=9, mtime=0) as gz:
+        gz.write(raw.getvalue())
+    return out.getvalue()
+
+
+def pack(
+    root: Path,
+    *,
+    max_bytes: int = 2_000_000,
+    max_patch_bytes: int = 262_144,
+    exclude: tuple[str, ...] = (),
+    log_tail_lines: int = 3000,
+) -> tuple[bytes, dict[str, object]]:
+    """Archive bytes and the index of ``root`` (see the module docstring)."""
+    files: dict[str, bytes] = {}
+    index: dict[str, dict[str, object]] = {}
+    for p in sorted(root.rglob("*")):
+        if not p.is_file():
+            continue
+        name = p.relative_to(root).as_posix()
+        data = p.read_bytes()
+        entry: dict[str, object] = {"bytes": len(data), "sha256": _sha(data)}
+        if any(fnmatch.fnmatch(name, g) for g in exclude):
+            entry["included"] = False
+            entry["reason"] = "excluded"
+        elif p.name == "dirty.patch" and len(data) > max_patch_bytes:
+            entry["included"] = False
+            entry["reason"] = f"dirty.patch larger than {max_patch_bytes} bytes"
+        else:
+            if p.suffix == ".log" and data.count(b"\n") > log_tail_lines:
+                data = b"\n".join(data.split(b"\n")[-log_tail_lines:])
+                entry["truncated_to_last_lines"] = log_tail_lines
+            files[name] = data
+            entry["included"] = True
+        index[name] = entry
+
+    def archive() -> bytes:
+        idx = json.dumps({"files": index, "max_bytes": max_bytes}, indent=1, sort_keys=True)
+        return build_archive({**files, "PACK_INDEX.json": idx.encode()})
+
+    blob = archive()
+    while len(blob) > max_bytes:
+        cands = [n for n in files if Path(n).name not in ESSENTIAL and not n.endswith(".log")]
+        if not cands:
+            break
+        big = max(cands, key=lambda n: len(files[n]))
+        del files[big]
+        index[big]["included"] = False
+        index[big]["reason"] = "dropped to fit the console budget"
+        blob = archive()
+    info = {
+        "archive_bytes": len(blob),
+        "files_included": len(files),
+        "files_dropped": sum(1 for e in index.values() if not e.get("included")),
+        "fits": len(blob) <= max_bytes,
+    }
+    return blob, info
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Command-line entry point."""
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--in", dest="src", type=Path, required=True)
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--max-bytes", type=int, default=2_000_000)
+    ap.add_argument("--max-patch-bytes", type=int, default=262_144)
+    ap.add_argument("--exclude", action="append", default=[])
+    a = ap.parse_args(argv)
+    blob, info = pack(
+        a.src, max_bytes=a.max_bytes, max_patch_bytes=a.max_patch_bytes, exclude=tuple(a.exclude)
+    )
+    a.out.write_bytes(blob)
+    print(json.dumps({**info, "sha256": _sha(blob), "out": str(a.out)}))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
