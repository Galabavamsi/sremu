+"""WP11 benchmark suites: smoke tests of the shared plumbing and quick suite paths.
+
+These check that the benchmark code measures what it claims (non-zero RIS path assertion,
+grid bookkeeping, manifests with data classes, the Windows paced label, the v1 import fix
+being the only change, fits recovering known exponents); they do not assert any timing.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from bench import _common, _scenes, b1_kernels, b2_lockstep, b5_v1
+
+pytestmark = pytest.mark.unit
+
