index 0000000000000000000000000000000000000000..d31ce600e8aab7cb9ccf45c9afbddbb421936fac
--- /dev/null
+++ b/bench/aws/user_data.sh
@@ -0,0 +1,177 @@
+#!/bin/bash
+# sremu AWS benchmark job: cloud-init user data for Ubuntu 24.04 (DESIGN.md 12.4; WP11).
+# Render with: python bench/aws/make_bundle.py render --job JOB --url URL --sha256 SHA --maxmin MIN
+# No IAM role, no SSH, no inbound rules: results leave only through the serial console
+# (framed base64, see bench/aws/console_stream.py), then the instance powers off
+# (launch with InstanceInitiatedShutdownBehavior=terminate). Steps:
+#  1 hard cap (shutdown -h +MAXMIN)  2 download + verify bundle  3 apt  4 venv(s)
+#  5 governor + taskset pinning  6 job (timeout)  7 pack (<2 MB) + stream x3 + poweroff
+set -u
+MAXMIN="${SREMU_MAXMIN:-__MAXMIN__}"
+BUNDLE_URL="${SREMU_BUNDLE_URL:-__BUNDLE_URL__}"
+BUNDLE_SHA256="${SREMU_BUNDLE_SHA256:-__BUNDLE_SHA256__}"
+JOB="${SREMU_JOB:-__JOB__}"
+DRYRUN="${SREMU_DRYRUN:-0}"
+SKIP_APT="${SREMU_SKIP_APT:-0}"
+ROOT="${SREMU_ROOT:-/opt/sremu}"
+CONSOLE="${SREMU_CONSOLE:-/dev/ttyS0}"
+STREAM_BPS="${SREMU_STREAM_BPS:-8000}"
+STREAM_PAUSE="${SREMU_STREAM_PAUSE:-20}"
+PY="${SREMU_PYTHON:-python3.12}"
+RESERVE_MIN="${SREMU_RESERVE_MIN:-25}"
+export HOME="${HOME:-/root}"  # cloud-init may run user scripts without HOME (pip, numba caches)
+T0=$(date +%s)
+
+# ---- 1. hard cap on the instance lifetime, before anything else
+if [ "$DRYRUN" = "1" ]; then
+  echo "[dryrun] shutdown -h +$MAXMIN"
+else
+  shutdown -h "+$MAXMIN" "sremu hard cap" || /sbin/shutdown -h "+$MAXMIN" || true
+fi
+
+mkdir -p "$ROOT/out" "$ROOT/src"
+LOG="$ROOT/out/user_data.log"
+SRC="$ROOT/src"
+say() {
+  local msg
+  msg="SREMU-LOG|$JOB|$(( $(date +%s) - T0 ))s|$*"
+  echo "$msg" >> "$LOG"
+  { echo "$msg" >> "$CONSOLE"; } 2>/dev/null || true
+}
+
+# the console streamer is embedded so results (or the failure log) can leave even if the
+# bundle never arrives
+cat > "$ROOT/console_stream.py" <<'SREMU_PY_EOF'
+__CONSOLE_STREAM_PY__
+SREMU_PY_EOF
+
+HB=""
+finish() {
+  local rc="$1"
+  [ -n "$HB" ] && kill "$HB" 2>/dev/null
+  say "finished rc=$rc; packing results"
+  printf '{"job": "%s", "user_data_rc": %s, "elapsed_s": %s, "governor": "%s", "cpus": "%s"}\n' \
+    "$JOB" "$rc" "$(( $(date +%s) - T0 ))" "${GOV:-unknown}" "${CPUS:-all}" \
+    > "$ROOT/out/user_data_status.json"
+  if [ -f "$SRC/bench/aws/pack_results.py" ]; then
+    python3 "$SRC/bench/aws/pack_results.py" --in "$ROOT/out" --out "$ROOT/results.tar.gz" \
+      --max-bytes 2000000 >> "$LOG" 2>&1 || tar -czf "$ROOT/results.tar.gz" -C "$ROOT/out" .
+  else
+    tar -czf "$ROOT/results.tar.gz" -C "$ROOT/out" .
+  fi
+  say "streaming $(stat -c %s "$ROOT/results.tar.gz" 2>/dev/null) bytes"
+  python3 "$ROOT/console_stream.py" --job "$JOB" --file "$ROOT/results.tar.gz" --passes 3 \
+    --pause-s "$STREAM_PAUSE" --bps "$STREAM_BPS" >> "$CONSOLE" 2>> "$LOG" || say "stream failed"
+  sync
+  if [ "$DRYRUN" = "1" ]; then
+    echo "[dryrun] poweroff (rc=$rc)"
+  else
+    poweroff || shutdown -h now
+  fi
+  exit "$rc"
+}
+
+case "$JOB" in
+  b3_paced|b4_paced|b5_v1_vs_sremu|b2_server_point|eb3_paced_controller|smoke|selftest) ;;
+  *) say "unknown job '$JOB'"; finish 2 ;;
+esac
+say "start: job=$JOB maxmin=$MAXMIN"
+
+# ---- 2. bundle: download first (the pre-signed URL is valid for 15 min) and verify
+ok=0
+for _ in 1 2 3 4 5; do
+  if curl -fsS --retry 3 --connect-timeout 20 --max-time 900 -o "$ROOT/bundle.tar.gz" \
+      "$BUNDLE_URL" >> "$LOG" 2>&1; then ok=1; break; fi
+  sleep 5
+done
+[ "$ok" = "1" ] || { say "bundle download failed"; finish 10; }
+GOT=$(sha256sum "$ROOT/bundle.tar.gz" | cut -d' ' -f1)
+if [ "$GOT" != "$BUNDLE_SHA256" ]; then say "bundle sha256 mismatch: $GOT"; finish 11; fi
+tar -xzf "$ROOT/bundle.tar.gz" -C "$SRC" >> "$LOG" 2>&1 || { say "bundle extract failed"; finish 12; }
+say "bundle ok sha256=$GOT"
+
+HBLOOP() { while sleep 60; do say "heartbeat"; done; }
+HBLOOP & HB=$!
+
+# ---- 3. packages (and quiet the host: no background package jobs during timing)
+if [ "$SKIP_APT" != "1" ]; then
+  export DEBIAN_FRONTEND=noninteractive
+  apt-get -o DPkg::Lock::Timeout=600 update -q >> "$LOG" 2>&1 \
+    && apt-get -o DPkg::Lock::Timeout=600 install -y -q python3.12-venv python3-pip \
+       build-essential util-linux >> "$LOG" 2>&1 || { say "apt failed"; finish 20; }
+  systemctl stop unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer \
+    snapd.service snapd.socket >> "$LOG" 2>&1 || true
+fi
+
+# ---- 4. virtual environments (pinned; unpinned fallback is recorded)
+VPY="python3"
+if [ "$JOB" != "selftest" ]; then
+  REQ="$SRC/bench/aws/requirements-aws.txt"
+  "$PY" -m venv "$ROOT/venv" >> "$LOG" 2>&1 || { say "venv failed"; finish 30; }
+  if ! "$ROOT/venv/bin/pip" install -q --no-input -r "$REQ" >> "$LOG" 2>&1; then
+    say "pinned install failed; trying unpinned"
+    sed 's/==.*//' "$REQ" > "$ROOT/req_unpinned.txt"
+    "$ROOT/venv/bin/pip" install -q --no-input -r "$ROOT/req_unpinned.txt" >> "$LOG" 2>&1 \
+      || { say "pip install failed"; finish 31; }
+    echo "unpinned" > "$ROOT/out/PINS_NOT_HONORED"
+  fi
+  "$ROOT/venv/bin/pip" install -q --no-input --no-deps --no-build-isolation -e "$SRC" \
+    >> "$LOG" 2>&1 || { say "sremu install failed"; finish 32; }
+  VPY="$ROOT/venv/bin/python"
+  if [ "$JOB" = "b5_v1_vs_sremu" ]; then
+    "$PY" -m venv "$ROOT/venv_v1" >> "$LOG" 2>&1 \
+      && "$ROOT/venv_v1/bin/pip" install -q --no-input -r "$SRC/bench/aws/requirements-v1.txt" \
+         >> "$LOG" 2>&1 || { say "v1 venv failed"; finish 33; }
+  fi
+fi
+say "environment ready"
+
+# ---- 5. CPU governor (where the VM exposes cpufreq) and pinning
+GOV="unavailable"
+if [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
+  for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
+    echo performance > "$f" 2>/dev/null || true
+  done
+  GOV=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
+fi
+# engine: every CPU except the cores of CPU 0 and 1 (with their SMT siblings), which take
+# the OS and the client processes (bench.pin_client_cpus reads SREMU_CLIENT_CPUS)
+TOPO=$(python3 - <<'PYEOF'
+import os
+n = os.cpu_count() or 1
+def sib(c):
+    try:
+        t = open(f"/sys/devices/system/cpu/cpu{c}/topology/thread_siblings_list").read()
+    except OSError:
+        return {c}
+    out = set()
+    for p in t.strip().split(","):
+        a, _, b = p.partition("-")
+        out.update(range(int(a), int(b or a) + 1))
+    return out
+cl = sib(0) | sib(1) if n >= 8 else set()
+en = [c for c in range(n) if c not in cl]
+print(",".join(map(str, en)), ",".join(map(str, sorted(cl))) or "-", len(en))
+PYEOF
+)
+read -r CPUS CCPUS NT <<< "$TOPO"
+[ "$CCPUS" = "-" ] && CCPUS=""
+export SREMU_GOVERNOR="$GOV" SREMU_CPUS="$CPUS" SREMU_CLIENT_CPUS="$CCPUS"
+export NUMBA_NUM_THREADS="$NT" NUMBA_DISABLE_INTEL_SVML=1
+say "governor=$GOV cpus=$CPUS client_cpus=${CCPUS:-none} numba_threads=$NT"
+
+# ---- 6. the job, within the time left before the hard cap (RESERVE_MIN for pack + stream)
+JOB_MIN=$(( MAXMIN - ($(date +%s) - T0) / 60 - RESERVE_MIN ))
+[ "$JOB_MIN" -ge 3 ] || { say "not enough time before the hard cap"; finish 40; }
+BUDGET=$(( JOB_MIN - 3 < 85 ? JOB_MIN - 3 : 85 ))
+[ "$BUDGET" -ge 1 ] || BUDGET=1
+cd "$SRC" || finish 41
+say "running $JOB (budget ${BUDGET} min, timeout ${JOB_MIN} min)"
+timeout --signal=INT --kill-after=60 "$(( JOB_MIN * 60 ))" taskset -c "$CPUS" "$VPY" \
+  bench/aws/run_job.py "$JOB" --out "$ROOT/out" --python "$VPY" \
+  --v1-python "$ROOT/venv_v1/bin/python" --budget-min "$BUDGET" >> "$LOG" 2>&1
+RC=$?
+say "job exit $RC"
+
+# ---- 7. pack, stream three times, power off
+finish "$RC"
diff --git a/bench/b1_kernels.py b/bench/b1_kernels.py
