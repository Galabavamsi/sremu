+def prior_variants(protocol: Mapping[str, Any]) -> tuple[str, ...]:
+    """Ids of the sensitivity runs that use an alternative prior (``prior_overrides``)."""
+    return tuple(
+        str(r["id"]) for r in protocol.get("sensitivity_runs", []) if "prior_overrides" in r
+    )
+
