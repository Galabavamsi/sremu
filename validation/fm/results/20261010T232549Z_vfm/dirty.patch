index 0000000000000000000000000000000000000000..c1449ecdc218687d723015fc20dba921d305dff9
--- /dev/null
+++ b/bench/b6_crosstool.py
@@ -0,0 +1,407 @@
+"""B6: cross-tool context, time per RIS channel evaluation on one scene (section 12.2, RQ-44).
+
+Usage::
+
+    python -m bench.b6_crosstool [--sizes 256,1024,4096] [--no-matlab] [--no-v2] [--out DIR]
+
+Scene (SIM): one link at 3.5 GHz; a square panel of N in {256, 1024, 4096} cells at 42.8 mm
+pitch centred at the origin, facing +x; Tx 5 m at -30 deg and Rx 5 m at +20 deg (angles
+from the normal in the x-y plane); one random 1-bit configuration (Gamma = +1/-1, the same
+for every tool). One "channel evaluation" is h = LOS + RIS sum for that configuration.
+
+Tools, all timed on this host in one session:
+
+* **sremu** (``numba_cpu`` and ``numpy_ref``): ``ScenePropagation.snapshot(t)`` +
+  ``combine`` (full evaluation for new positions), and ``combine`` alone (configuration
+  change, geometry cached);
+* **MATLAB R2026a** (``bench/b6_matlab.m`` via ``matlab -batch``): the vectorized
+  per-element K1 sum, the same sum as a per-element loop, the toolbox-primitive path
+  ``golden_util_k1`` (sremu ``tools/matlab``) and one ``phased.RISReflector`` step;
+* **v2** (scratch copy of ``D:\\ris-sim\\v2``, never modified in place): its
+  ``free_space_coefficient`` + ``total_nlos_gain`` (a Python per-element loop that re-reads
+  ``config/ris.json`` on every call, as v2 does).
+
+**Scope caveats** (also in meta.json): the tools do not evaluate the same model:
+``RISReflector`` is far-field plane-wave with unit-gain cells, v2 lacks the cell-area factor
+and uses c = 3e8 m/s, MATLAB times exclude MATLAB start-up; sremu's numbers include its
+Python dispatch. The literature numbers (ACHEM 82-167 us end to end, Colosseum 1 ms
+snapshots, ORIX 10 ms-1 s loop, TRACE 5.2 ms control RTT) are quoted with their own
+hardware as REPORTED context, never as a speed comparison.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+import shutil
+import subprocess
+import sys
+import textwrap
+import time
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+import bench
+from bench._common import REPO, BenchRun, time_calls
+
+SUITE = "b6"
+FC_HZ = 3.5e9
+PITCH_M = 0.0428
+MATLAB_EXE = Path(r"C:\Program Files\MATLAB\R2026a\bin\matlab.exe")
+V2_SOURCE = Path(r"D:\ris-sim\v2")
+V2_DEFAULT_DIR = Path(r"D:\projects\ris\research\scratch\v2_bench")
+LITERATURE = [
+    {
+        "tool": "ACHEM (arXiv 2604.04742)",
+        "quantity": "end-to-end latency",
+        "value": "82-167 us",
+        "hardware": "as reported by the authors",
+        "data_class": "REPORTED",
+    },
+    {
+        "tool": "Colosseum + RIS (Tsampazi 2025)",
+        "quantity": "channel snapshot period",
+        "value": "1 ms",
+        "hardware": "Colosseum FPGA channel emulator",
+        "data_class": "REPORTED",
+    },
+    {
+        "tool": "ORIX / GoSimRIS",
+        "quantity": "control loop",
+        "value": "10 ms-1 s",
+        "hardware": "as reported",
+        "data_class": "REPORTED",
+    },
+    {
+        "tool": "TRACE (arXiv 2608.11798)",
+        "quantity": "control round trip (UDP)",
+        "value": "5.2 ms",
+        "hardware": "as reported",
+        "data_class": "REPORTED",
+    },
+]
+
+
+def scene(sizes: list[int], seed: int = 7) -> dict[str, Any]:
+    """The B6 scene (positions, carrier, panels and their 1-bit configurations)."""
+    rng = np.random.default_rng(seed)
+    a_tx, a_rx = math.radians(-30.0), math.radians(20.0)
+    panels = []
+    for n in sizes:
+        side = round(math.sqrt(n))
+        if side * side != n:
+            raise ValueError(f"B6 sizes must be squares, got {n}")
+        bits = rng.integers(0, 2, n)
+        panels.append(
+            {
+                "n_u": side,
+                "n_v": side,
+                "pitch_m": PITCH_M,
+                "bits": bits.tolist(),
+                "gamma": [1.0 if b == 0 else -1.0 for b in bits],
+            }
+        )
+    return {
+        "fc_hz": FC_HZ,
+        "tx_m": [5 * math.cos(a_tx), 5 * math.sin(a_tx), 0.0],
+        "rx_m": [5 * math.cos(a_rx), 5 * math.sin(a_rx), 0.0],
+        "panels": panels,
+    }
+
+
+# =========================================================================== sremu
+
+
+def sremu_rows(sc: dict[str, Any]) -> list[dict[str, Any]]:
+    from bench._engine_point import _resolve
+    from sremu.contracts import PanelConfig
+    from sremu.physics.propagation import from_scenario
+
+    out = []
+    for pn in sc["panels"]:
+        n = pn["n_u"] * pn["n_v"]
+        d = {
+            "schema_version": "1.0",
+            "name": f"b6_n{n}",
+            "seed": 1,
+            "nodes": [
+                {
+                    "id": "tx",
+                    "position_m": sc["tx_m"],
+                    "antenna": {"pattern": "isotropic"},
+                    "streams": [
+                        {
+                            "name": "tx0",
+                            "direction": "tx",
+                            "fc_hz": FC_HZ,
+                            "rate_sps": "1e6",
+                            "occupied_bw_hz": 8e5,
+                        }
+                    ],
+                },
+                {
+                    "id": "rx",
+                    "position_m": sc["rx_m"],
+                    "antenna": {"pattern": "isotropic"},
+                    "streams": [
+                        {"name": "rx0", "direction": "rx", "fc_hz": FC_HZ, "rate_sps": "1e6"}
+                    ],
+                },
+            ],
+            "ris": [
+                {
+                    "id": "ris0",
+                    "pose": {"center_m": [0, 0, 0], "normal": [1, 0, 0], "u_axis": [0, 1, 0]},
+                    "grid": {
+                        "n_u": pn["n_u"],
+                        "n_v": pn["n_v"],
+                        "pitch_u_m": PITCH_M,
+                        "pitch_v_m": PITCH_M,
+                    },
+                    "states": {"library": "ideal_antipodal"},
+                    "initial": {"fill": 0},
+                }
+            ],
+            "run": {"duration_s": "1"},
+        }
+        res = _resolve(d)
+        for be in ("numba_cpu", "numpy_ref"):
+            model = from_scenario(res.scenario.model_dump(mode="python"), backend=be)
+            cfg = {"ris0": PanelConfig("ris0", np.asarray(pn["bits"], dtype=np.int16))}
+            ts = iter(Fraction(i, 1000) for i in range(10**9))
+            full = time_calls(
+                lambda m=model, c=cfg, ts=ts: m.combine(m.snapshot(next(ts)), c), min_time_s=0.3
+            )
+            snap = model.snapshot(Fraction(0))
+            comb = time_calls(lambda m=model, s=snap, c=cfg: m.combine(s, c), min_time_s=0.3)
+            h = model.evaluate(snap, cfg)
+            for kind, st in (("snapshot+combine", full), ("combine_only", comb)):
+                out.append(
+                    {
+                        "tool": "sremu",
+                        "method": f"sremu_{be}_{kind}",
+                        "N": n,
+                        "t_median_s": st["median"],
+                        "t_min_s": st["min"],
+                        "n_calls": int(st["n"]),
+                        "h_abs_db": 20 * math.log10(abs(complex(h["tx.tx0->rx.rx0"]))),
+                        "scenario_sha256": res.sha256(),
+                    }
+                )
+            print(
+                f"sremu {be} N={n}: full {full['median'] * 1e3:.3f} ms, "
+                f"combine {comb['median'] * 1e3:.3f} ms",
+                flush=True,
+            )
+    return out
+
+
+# =========================================================================== MATLAB
+
+
+def matlab_rows(
+    sc_path: Path, out_dir: Path, exe: Path = MATLAB_EXE
+) -> tuple[list[dict[str, Any]], str]:
+    """Run ``bench/b6_matlab.m`` with ``matlab -batch``; returns rows and the console log."""
+    if not exe.exists():
+        return [], f"MATLAB not found at {exe}"
+    out_csv = out_dir / "matlab_raw.csv"
+    bench_dir = (REPO / "bench").as_posix()
+    cmd = [
+        str(exe),
+        "-batch",
+        f"addpath('{bench_dir}'); b6_matlab('{out_csv.as_posix()}', '{sc_path.as_posix()}')",
+    ]
+    t0 = time.perf_counter()
+    r = subprocess.run(cmd, capture_output=True, text=True, timeout=3600)
+    wall = time.perf_counter() - t0
+    log = f"rc={r.returncode} wall={wall:.1f}s\n{r.stdout}\n{r.stderr}"
+    rows = []
+    if r.returncode == 0 and out_csv.exists():
+        with out_csv.open(encoding="utf-8") as fh:
+            for row in csv.DictReader(fh):
+                rows.append(
+                    {
+                        "tool": "MATLAB",
+                        "method": row["method"],
+                        "N": int(row["N"]),
+                        "t_median_s": float(row["t_median_s"]),
+                        "t_min_s": None,
+                        "n_calls": None,
+                        "h_abs_db": float(row["h_abs_db"])
+                        if row.get("h_abs_db") not in (None, "", "NaN")
+                        else None,
+                        "matlab_release": row.get("matlab_release"),
+                    }
+                )
+    return rows, log
+
+
+# =========================================================================== v2
+
+_V2_DRIVER = textwrap.dedent(
+    """
+    import json, math, sys, time
+    sys.path.insert(0, '.')
+    import modules.channel_functions as cf
+    sc = json.load(open(sys.argv[1]))
+    fc = sc['fc_hz']; tx = sc['tx_m']; rx = sc['rx_m']
+    d = math.dist(tx, rx)
+    def once():
+        return cf.free_space_coefficient(fc, d) + cf.total_nlos_gain(fc, tx, rx)
+    h = once()
+    ts = []
+    t_end = time.perf_counter() + float(sys.argv[2])
+    while len(ts) < 3 or time.perf_counter() < t_end:
+        t0 = time.perf_counter(); once(); ts.append(time.perf_counter() - t0)
+    ts.sort()
+    print(json.dumps({'t_median_s': ts[len(ts) // 2], 't_min_s': ts[0], 'n_calls': len(ts),
+                      'h_abs_db': 20 * math.log10(abs(h)) if h else None}))
+    """
+)
+
+
+def prepare_v2(dest: Path = V2_DEFAULT_DIR, source: Path = V2_SOURCE) -> Path:
+    """Fresh scratch copy of v2's ``ris_sim`` package (the source is never modified)."""
+    pkg = dest / "ris_sim"
+    if not pkg.exists():
+        shutil.copytree(
+            source / "ris_sim",
+            pkg,
+            ignore=shutil.ignore_patterns("__pycache__", "tests", "web", "*.lock"),
+        )
+    return pkg
+
+
+def v2_rows(sc: dict[str, Any], v2_dir: Path, run_dir: Path) -> tuple[list[dict[str, Any]], str]:
+    try:
+        pkg = prepare_v2(v2_dir)
+    except OSError as exc:
+        return [], f"v2 copy failed: {exc}"
+    (pkg / "_b6_driver.py").write_text(_V2_DRIVER, encoding="utf-8")
+    rows = []
+    logs = []
+    for pn in sc["panels"]:
+        n = pn["n_u"] * pn["n_v"]
+        side_u = pn["n_u"] * PITCH_M
+        side_v = pn["n_v"] * PITCH_M
+        cfg_mat = [
+            [int(pn["bits"][iv * pn["n_u"] + iu]) for iu in range(pn["n_u"])]
+            for iv in range(pn["n_v"])
+        ]
+        ris = {
+            "ris": [
+                {
+                    "id": "ris0",
+                    "fc": FC_HZ,
+                    "type": "static",
+                    "plane": 5,
+                    "location": [0.0, -side_u / 2, -side_v / 2],
+                    "unit_cell_m_length": PITCH_M,
+                    "unit_cell_n_length": PITCH_M,
+                    "unit_cell_gap": 0.0,
+                    "array_size": [pn["n_v"], pn["n_u"]],
+                    "phase_response": {"0": [1.0, 0.0], "1": [-1.0, 0.0]},
+                    "configuration_matrix": cfg_mat,
+                }
+            ]
+        }
+        (pkg / "config").mkdir(exist_ok=True)
+        (pkg / "config" / "ris.json").write_text(json.dumps(ris), encoding="utf-8")
+        scp = run_dir / f"v2_scene_n{n}.json"
+        scp.write_text(json.dumps({k: sc[k] for k in ("fc_hz", "tx_m", "rx_m")}), encoding="utf-8")
+        r = subprocess.run(
+            [sys.executable, "_b6_driver.py", str(scp.resolve()), "1.0"],
+            cwd=pkg,
+            capture_output=True,
+            text=True,
+            timeout=1800,
+        )
+        logs.append(f"N={n} rc={r.returncode} {r.stdout.strip()} {r.stderr.strip()[-500:]}")
+        if r.returncode == 0:
+            d = json.loads(r.stdout.strip().splitlines()[-1])
+            rows.append({"tool": "v2", "method": "v2_total_nlos_gain+los", "N": n, **d})
+            print(f"v2 N={n}: {d['t_median_s'] * 1e3:.2f} ms", flush=True)
+    return rows, "\n".join(logs)
+
+
+# =========================================================================== main
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run B6 and write its run directory."""
+    bench.deterministic_env()
+    ap = argparse.ArgumentParser(prog="bench.b6_crosstool", description=__doc__.splitlines()[0])
+    ap.add_argument("--sizes", default="256,1024,4096")
+    ap.add_argument("--no-matlab", action="store_true")
+    ap.add_argument("--no-v2", action="store_true")
+    ap.add_argument("--matlab", type=Path, default=MATLAB_EXE)
+    ap.add_argument("--v2-dir", type=Path, default=V2_DEFAULT_DIR)
+    ap.add_argument("--out", type=Path, default=None)
+    ap.add_argument("--tag", default=None)
+    ap.add_argument("--wait-quiet-min", type=float, default=0.0)
+    ap.add_argument("--threads", type=int, default=None, help="numba threads (default: all)")
+    a = ap.parse_args(argv)
+    bench.set_threads(a.threads)
+    sizes = [int(x) for x in a.sizes.split(",") if x]
+    sc = scene(sizes)
+    spec = {
+        "threads": a.threads,
+        "sizes": sizes,
+        "scene": {k: sc[k] for k in ("fc_hz", "tx_m", "rx_m")},
+        "matlab": not a.no_matlab,
+        "v2": not a.no_v2,
+    }
+    run = BenchRun(
+        SUITE,
+        spec,
+        out_root=a.out,
+        tag=a.tag,
+        data_classes={"times.csv": "MEAS", "literature.csv": "REPORTED", "*": "MEAS"},
+        workload_classes={
+            "times.csv": "SIM-sremu / MATLAB / SIM-legacy-v2 (column 'tool')",
+            "*": "SIM-sremu",
+        },
+        caveats=[
+            "Different tools evaluate different models: RISReflector is far-field plane-wave "
+            "with unit-gain cells; v2 has no cell-area factor and c = 3e8; only sremu and the "
+            "MATLAB hand/toolbox K1 paths compute the same near-field K1 sum.",
+            "MATLAB times exclude MATLAB start-up (timeit inside one session).",
+            "Literature numbers are REPORTED with their own hardware; not a speed comparison.",
+        ],
+        wait_quiet_s=a.wait_quiet_min * 60.0,
+    )
+    sc_path = run.path("scene.json")
+    sc_path.write_text(json.dumps(sc), encoding="utf-8")
+    rows: list[dict[str, Any]] = []
+    with run.interruptible():
+        rows += sremu_rows(sc)
+        if not a.no_v2:
+            r2, log2 = v2_rows(sc, a.v2_dir, run.dir)
+            rows += r2
+            run.path("v2_console.log").write_text(log2, encoding="utf-8")
+        if not a.no_matlab:
+            rm, logm = matlab_rows(sc_path, run.dir, a.matlab)
+            rows += rm
+            run.path("matlab_console.log").write_text(logm, encoding="utf-8")
+    run.write_csv("times.csv", rows)
+    run.write_csv("literature.csv", LITERATURE)
+    summary = {
+        "suite": SUITE,
+        "per_N": {
+            str(n): {r["method"]: r["t_median_s"] for r in rows if r["N"] == n} for n in sizes
+        },
+        "tools_run": sorted({r["tool"] for r in rows}),
+    }
+    run.finish(summary)
+    print(f"B6 written to {run.dir}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
