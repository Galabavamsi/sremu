+    body = "import numpy as np\r\nimport scipy\r\n\r\nimport commpy\r\nx = 1\r\n"
+    (mod / "channel_functions.py").write_bytes(body.encode())
+    (src / "ris_sim" / "core" / "engine.py").write_text("print('engine')\n")
+    gen = tmp_path / "gen.py"
+    gen.write_text("# generator\n")
+    dest = tmp_path / "v1_bench"
