index 0000000000000000000000000000000000000000..1d6de5cbd6fe76832cbfc037b1ef27a4671c23b3
--- /dev/null
+++ b/bench/b5_v1.py
@@ -0,0 +1,433 @@
+"""B5: the historical v1 workload, v1-as-committed vs sremu on the SAME host (section 12.2).
+
+Usage::
+
+    python -m bench.b5_v1 [--v1-dir DIR] [--v1-python PY] [--nodes 2,4,...] [--reps 3]
+
+**v1 as committed.** :func:`prepare_v1` copies ``D:\\ris-sim\\original`` (never modified)
+to a scratch directory (default ``D:\\projects\\ris\\research\\scratch\\v1_bench``) and
+applies the ONE import fix documented in ``research/audit_v1.md`` (bug B28, the "preimp"
+variant of the audit's Fig. 3 reconstruction): ``import scipy.signal`` after ``import
+scipy`` in ``modules/channel_functions.py``, because ``channel_functions`` calls
+``scipy.signal`` after importing only ``scipy`` (a lazy first-touch import that otherwise
+lands inside the timed region). The patch is written to the run directory. Nothing else
+is changed: in particular the engine keeps its committed tick ``tau = 2 ms``.
+
+**Workload** (ANTS Fig. 3, recovered from the bytecode of the missing
+``generate_scenario.py``, ``research/audit_v1.md`` section 10.2): FC = 2 GHz, SR = 5000 S/s,
+N static nodes uniform in 50 x 50 x 5 m (positions rounded to 2 decimals, seed 1 + rep),
+N // 2 transmitters each sending 10 samples of 1+1j, the other nodes receiving 10 samples;
+the committed 16 x 16 ``ris.json`` is used every tick. At the committed tau = 2 ms the 10
+samples are exactly one tick (the audit shows the same workload crashes at tau = 0.3-1 s,
+bug B8, so the plotted tau values cannot be run without further changes, which this
+benchmark does not make). The scenario is written by the audit's reconstruction of the
+generator (``gen_scenario_reconstructed.py``, copied next to the v1 tree). v1's own timer
+(``Total time taken for simulation``) is reported, plus the subprocess wall time.
+
+**sremu, same workload and host.** The same node positions, N // 2 TX streams sending the
+same 10 samples (1+1j) at 5000 S/s and 2 GHz, the other nodes RX; a 16 x 16 panel (5 cm
+cells, 1 cm gaps, i.e. 6 cm pitch) at v1's RIS location (0, 5, 5) m facing +x, ideal
+antipodal states, all cells in state 0 (v1's dummy controller sets every cell to 1, i.e.
+the same phase everywhere); noise off (v1 adds none); default declared bandwidth
+0.8 f_s. Reported per N: wall time to build the engine, wall time to emulate the 2 ms
+(10 samples) right after the build, and the steady-state RTF over 1 s of virtual time.
+
+**Scope** (stated in meta.json): v1 and sremu do not compute the same physics (v1's
+passband chain, missing LOS phase and RIS scaling errors; sremu's K1 kernel and FD
+filters), and v1 moves data through JSON files. B5 compares wall-clock cost of the same
+nominal workload on one machine; it is not a fidelity comparison and no cross-machine
+number is used.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import os
+import re
+import shutil
+import statistics
+import subprocess
+import sys
+import time
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import bench
+from bench._common import BenchRun
+
+SUITE = "b5"
+V1_SOURCE = Path(r"D:\ris-sim\original")
+V1_DEFAULT_DIR = Path(r"D:\projects\ris\research\scratch\v1_bench")
+V1_DEFAULT_PY = Path(r"D:\projects\ris\research\scratch\venv_v1\Scripts\python.exe")
+GEN_SOURCE = Path(r"D:\projects\ris\research\scratch\v1_audit\gen_scenario_reconstructed.py")
+IMPORT_FIX_ANCHOR = "import scipy\n"
+IMPORT_FIX_LINE = "import scipy.signal  # B5: the one import fix of audit_v1.md (B28)\n"
+NODES = (2, 4, 6, 8, 10, 12, 16, 20, 24, 31)
+FC_HZ = 2e9
+SR = 5000
+TAU_S = Fraction(2, 1000)
+
+
+# =========================================================================== v1 preparation
+
+
+RUNTIME_STATE_FILES = ("config/nodes.json", "config/output.json")
+"""Files of ``ris_sim/`` that the generator and the v1 engine rewrite on every run; they are
+excluded from the tree hashes so the hash identifies the code and static configuration."""
+
+
+def _tree_sha256(root: Path) -> str:
+    h = hashlib.sha256()
+    for p in sorted(root.rglob("*")):
+        rel = p.relative_to(root).as_posix()
+        if (
+            p.is_file()
+            and "__pycache__" not in p.parts
+            and ".git" not in p.parts
+            and rel not in RUNTIME_STATE_FILES
+        ):
+            h.update(rel.encode())
+            h.update(b"\0")
+            h.update(p.read_bytes())
+    return h.hexdigest()
+
+
+def prepare_v1(
+    dest: Path = V1_DEFAULT_DIR, source: Path = V1_SOURCE, gen: Path = GEN_SOURCE
+) -> dict[str, Any]:
+    """Copy v1 (if ``dest`` does not exist yet) and apply the one import fix (idempotent).
+
+    Returns the source/patched tree hashes, the v1 HEAD (read from ``.git`` files, no git
+    command) and the unified diff of the fix."""
+    if not dest.exists():
+        if not source.exists():
+            raise FileNotFoundError(f"v1 source {source} not found and {dest} does not exist")
+        shutil.copytree(source, dest, ignore=shutil.ignore_patterns("__pycache__"))
+        if gen.exists():
+            shutil.copy2(gen, dest / "gen_scenario_reconstructed.py")
+    cf = dest / "ris_sim" / "modules" / "channel_functions.py"
+    raw = cf.read_bytes()
+    crlf = b"\r\n" in raw
+    text = raw.decode("utf-8").replace("\r\n", "\n")
+    before = text
+    if IMPORT_FIX_LINE not in text:
+        if IMPORT_FIX_ANCHOR not in text:
+            raise RuntimeError("v1 channel_functions.py: 'import scipy' anchor not found")
+        text = text.replace(IMPORT_FIX_ANCHOR, IMPORT_FIX_ANCHOR + IMPORT_FIX_LINE, 1)
+        out = text.replace("\n", "\r\n") if crlf else text
+        cf.write_bytes(out.encode("utf-8"))
+        before_orig = before
+    else:
+        before_orig = text.replace(IMPORT_FIX_LINE, "", 1)
+    import difflib
+
+    diff = "".join(
+        difflib.unified_diff(
+            before_orig.splitlines(keepends=True),
+            text.splitlines(keepends=True),
+            "a/ris_sim/modules/channel_functions.py",
+            "b/ris_sim/modules/channel_functions.py",
+        )
+    )
+    head = None
+    git = dest / ".git" / "HEAD"
+    if git.exists():
+        ref = git.read_text().strip()
+        if ref.startswith("ref:"):
+            rp = dest / ".git" / ref.split(None, 1)[1]
+            head = rp.read_text().strip() if rp.exists() else ref
+        else:
+            head = ref
+    return {
+        "v1_dir": str(dest),
+        "v1_source": str(source),
+        "v1_git_head": head,
+        "source_tree_sha256": _tree_sha256(source / "ris_sim") if source.exists() else None,
+        "patched_tree_sha256": _tree_sha256(dest / "ris_sim"),
+        "tree_hash_excludes": list(RUNTIME_STATE_FILES),
+        "patch": diff,
+        "generator": str(dest / "gen_scenario_reconstructed.py"),
+        "generator_sha256": hashlib.sha256(
+            (dest / "gen_scenario_reconstructed.py").read_bytes()
+        ).hexdigest()
+        if (dest / "gen_scenario_reconstructed.py").exists()
+        else None,
+    }
+
+
+_TIME_RE = re.compile(r"Total time taken for simulation:\s*([0-9.eE+-]+)\s*seconds")
+
+
+def run_v1_once(v1_dir: Path, py: Path, n_nodes: int, seed: int) -> dict[str, Any]:
+    """Generate the workload and run v1's engine once (one tick at tau = 2 ms)."""
+    sim = v1_dir / "ris_sim"
+    (sim / "config" / "output.json").write_text("", encoding="utf-8")
+    env = dict(os.environ, SEED=str(seed), PYTHONDONTWRITEBYTECODE="1")
+    env.pop("NUMBA_CACHE_DIR", None)
+    gen = subprocess.run(
+        [str(py), str(v1_dir / "gen_scenario_reconstructed.py"), str(n_nodes), str(n_nodes // 2)],
+        cwd=sim,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=600,
+    )
+    if gen.returncode != 0:
+        raise RuntimeError(f"v1 generator failed: {gen.stderr[-2000:]}")
+    t0 = time.perf_counter()
+    r = subprocess.run(
+        [str(py), "core/engine.py"], cwd=sim, env=env, capture_output=True, text=True, timeout=3600
+    )
+    wall = time.perf_counter() - t0
+    m = _TIME_RE.search(r.stdout)
+    if r.returncode != 0 or m is None:
+        raise RuntimeError(
+            f"v1 engine failed (rc {r.returncode}): {r.stdout[-1000:]} {r.stderr[-2000:]}"
+        )
+    import json
+
+    nodes = json.loads((sim / "config" / "nodes.json").read_text(encoding="utf-8"))["nodes"]
+    return {
+        "t_sim_s": float(m.group(1)),
+        "process_wall_s": wall,
+        "positions": [n["location"] for n in nodes],
+        "all_idle": all(n["current_mode"] == "idle" for n in nodes),
+    }
+
+
+# =========================================================================== sremu side
+
+
+def sremu_scenario(positions: list[list[float]], n_tx: int) -> dict[str, Any]:
+    """The same workload as an sremu scenario (see the module docstring)."""
+    nodes = []
+    for i, p in enumerate(positions):
+        tx = i < n_tx
+        s: dict[str, Any] = {
+            "name": "tx0" if tx else "rx0",
+            "direction": "tx" if tx else "rx",
+            "fc_hz": FC_HZ,
+            "rate_sps": str(SR),
+        }
+        if tx:
+            s["occupied_bw_hz"] = 0.8 * SR
+        nodes.append(
+            {
+                "id": f"node_{i + 1}",
+                "position_m": [float(x) for x in p],
+                "antenna": {"pattern": "isotropic"},
+                "streams": [s],
+            }
+        )
+    return {
+        "schema_version": "1.0",
+        "name": f"b5_v1_workload_n{len(positions)}",
+        "seed": 1,
+        "description": "ANTS Fig. 3 workload (v1 B5 comparison; SIM)",
+        "numerics": {"backend": "numba_cpu"},
+        "nodes": nodes,
+        "ris": [
+            {
+                "id": "ris_1",
+                "pose": {
+                    "center_m": [0.0, 5.0, 5.0],
+                    "normal": [1.0, 0.0, 0.0],
+                    "u_axis": [0.0, 1.0, 0.0],
+                },
+                "grid": {"n_u": 16, "n_v": 16, "pitch_u_m": 0.06, "pitch_v_m": 0.06},
+                "states": {"library": "ideal_antipodal"},
+                "initial": {"fill": 0},
+            }
+        ],
+        "run": {"duration_s": "2/1000"},
+    }
+
+
+def run_sremu_once(positions: list[list[float]], n_tx: int) -> dict[str, Any]:
+    """Build, emulate the 2 ms tick, then 1 s of virtual time (steady-state RTF)."""
+    import numpy as np
+
+    from bench._engine_point import _resolve, build_engine
+    from bench._scenes import ris_path_check
+    from sremu.engine.streams import ArraySource
+
+    sc = sremu_scenario(positions, n_tx)
+    t0 = time.perf_counter()
+    res = _resolve(sc)
+    src = ArraySource(np.full(10, 1 + 1j, dtype=np.complex64))
+    traffic = {f"node_{i + 1}.tx0": src for i in range(n_tx)}
+    eng = build_engine(res, "F0", traffic=traffic)
+    t1 = time.perf_counter()
+    eng.run(until_s=TAU_S)
+    t2 = time.perf_counter()
+    chk = ris_path_check(eng.model)
+    eng.reset_metrics()
+    s = eng.run(until_s=TAU_S + 1)
+    eng.close()
+    return {
+        "build_s": t1 - t0,
+        "tick_s": t2 - t1,
+        "build_plus_tick_s": t2 - t0,
+        "steady_rtf": s.rtf.get("rtf"),
+        "steady_s_per_tick": float(TAU_S) / s.rtf["rtf"] if s.rtf.get("rtf") else None,
+        "links": len(eng.model.links()),
+        "min_ris_minus_los_db": chk["min_ris_minus_los_db"],
+        "scenario_sha256": res.sha256(),
+        "resolved": res,
+    }
+
+
+# =========================================================================== main
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run B5 and write its run directory."""
+    bench.deterministic_env()
+    ap = argparse.ArgumentParser(prog="bench.b5_v1", description=__doc__.splitlines()[0])
+    ap.add_argument("--v1-dir", type=Path, default=V1_DEFAULT_DIR)
+    ap.add_argument("--v1-source", type=Path, default=V1_SOURCE)
+    ap.add_argument("--v1-python", type=Path, default=V1_DEFAULT_PY)
+    ap.add_argument("--nodes", default=",".join(str(n) for n in NODES))
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--out", type=Path, default=None)
+    ap.add_argument("--tag", default=None)
+    ap.add_argument("--wait-quiet-min", type=float, default=0.0)
+    ap.add_argument("--threads", type=int, default=None, help="numba threads (default: all)")
+    a = ap.parse_args(argv)
+    bench.set_threads(a.threads)
+    nodes = [int(x) for x in a.nodes.split(",") if x]
+    prep = prepare_v1(a.v1_dir, a.v1_source)
+    v1_ver = subprocess.run(
+        [
+            str(a.v1_python),
+            "-c",
+            "import sys,numpy,scipy,commpy;"
+            "print(sys.version.split()[0],numpy.__version__,scipy.__version__,"
+            "getattr(commpy,'__version__','?'))",
+        ],
+        capture_output=True,
+        text=True,
+        timeout=120,
+    ).stdout.strip()
+    spec = {
+        "threads": a.threads,
+        "nodes": nodes,
+        "reps": a.reps,
+        "workload": "ANTS Fig. 3: FC 2 GHz, 5000 S/s, N static nodes in 50x50x5 m, N//2 TX x 10 "
+        "samples of 1+1j, rest RX 10 samples, committed 16x16 ris.json; v1 tick 2 ms",
+        "v1_patched_tree_sha256": prep["patched_tree_sha256"],
+        "v1_python": str(a.v1_python),
+        "v1_python_versions": v1_ver,
+    }
+    run = BenchRun(
+        SUITE,
+        spec,
+        out_root=a.out,
+        tag=a.tag,
+        data_classes={"*": "MEAS"},
+        workload_classes={"v1.csv": "SIM-legacy-v1", "sremu.csv": "SIM-sremu", "*": "SIM-sremu"},
+        caveats=[
+            "Same host, same nominal workload; v1 and sremu compute different physics and v1 "
+            "uses JSON-file IPC: a cost comparison, not a fidelity comparison.",
+            "v1 run as committed plus the one import fix (B28); tick tau = 2 ms as committed.",
+            "v1 T_sim is v1's own timer (after imports); process wall time includes Python "
+            "start-up and imports.",
+            "No cross-machine comparison: the ANTS Xeon numbers are not used.",
+        ],
+        wait_quiet_s=a.wait_quiet_min * 60.0,
+    )
+    (run.path("v1_import_fix.patch")).write_text(prep["patch"], encoding="utf-8", newline="\n")
+    run.write_json("v1_prepare.json", {k: v for k, v in prep.items() if k != "patch"})
+    v1_rows: list[dict[str, Any]] = []
+    s_rows: list[dict[str, Any]] = []
+    with run.interruptible():
+        # warm sremu kernels once (not recorded)
+        run_sremu_once([[1.0, 1.0, 1.0], [2.0, 3.0, 1.0]], 1)
+        for n in nodes:
+            for rep in range(a.reps):
+                seed = 1 + rep
+                v = run_v1_once(a.v1_dir, a.v1_python, n, seed)
+                links = (n // 2) * (n - n // 2)
+                v1_rows.append(
+                    {
+                        "tool": "v1",
+                        "N": n,
+                        "n_tx": n // 2,
+                        "links": links,
+                        "rep": rep,
+                        "seed": seed,
+                        "t_sim_s": v["t_sim_s"],
+                        "process_wall_s": v["process_wall_s"],
+                        "rtf": float(TAU_S) / v["t_sim_s"] if v["t_sim_s"] > 0 else None,
+                        "all_idle_after": v["all_idle"],
+                    }
+                )
+                s = run_sremu_once(v["positions"], n // 2)
+                pid = f"n{n}_rep{rep}"
+                sha = run.save_scenario(pid, s.pop("resolved"))
+                s_rows.append(
+                    {
+                        "tool": "sremu",
+                        "N": n,
+                        "n_tx": n // 2,
+                        "rep": rep,
+                        "seed": seed,
+                        **s,
+                        "scenario_sha256": sha,
+                    }
+                )
+                print(
+                    f"N={n:3d} rep={rep} v1 T_sim={v['t_sim_s']:.4f}s  "
+                    f"sremu build={s['build_s']:.4f}s tick={s['tick_s']:.5f}s "
+                    f"steady_rtf={s['steady_rtf']:.2f}",
+                    flush=True,
+                )
+                run.write_csv("v1.csv", v1_rows)
+                run.write_csv("sremu.csv", s_rows)
+    per_n = []
+    for n in nodes:
+        v = [r["t_sim_s"] for r in v1_rows if r["N"] == n]
+        s = [r for r in s_rows if r["N"] == n]
+        if not v or not s:  # interrupted before this N completed
+            continue
+        per_n.append(
+            {
+                "N": n,
+                "links": (n // 2) * (n - n // 2),
+                "v1_t_sim_median_s": statistics.median(v),
+                "v1_t_sim_min_s": min(v),
+                "v1_rtf_median": float(TAU_S) / statistics.median(v),
+                "sremu_build_plus_tick_median_s": statistics.median(
+                    r["build_plus_tick_s"] for r in s
+                ),
+                "sremu_tick_median_s": statistics.median(r["tick_s"] for r in s),
+                "sremu_steady_rtf_median": statistics.median(r["steady_rtf"] for r in s),
+                "sremu_steady_s_per_tick_median": statistics.median(
+                    r["steady_s_per_tick"] for r in s
+                ),
+                "ratio_v1_tsim_over_sremu_steady_tick": statistics.median(v)
+                / statistics.median(r["steady_s_per_tick"] for r in s),
+            }
+        )
+    run.write_csv("per_n.csv", per_n)
+    summary = {
+        "suite": SUITE,
+        "tau_s": float(TAU_S),
+        "per_n": per_n,
+        "v1_largest_N_rtf_ge_1": max(
+            (p["N"] for p in per_n if p["v1_rtf_median"] >= 1), default=None
+        ),
+        "sremu_largest_N_steady_rtf_ge_1": max(
+            (p["N"] for p in per_n if p["sremu_steady_rtf_median"] >= 1), default=None
+        ),
+        "v1_versions": v1_ver,
+    }
+    run.finish(summary, extra_meta={"v1": {k: v for k, v in prep.items() if k != "patch"}})
+    print(f"B5 written to {run.dir}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
