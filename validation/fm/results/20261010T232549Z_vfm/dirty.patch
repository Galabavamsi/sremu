new file mode 100644
index 0000000000000000000000000000000000000000..7aac609b67fcb95ab06b3ffa8ddaae132245e352
--- /dev/null
+++ b/src/sremu/commands/bench.py
@@ -0,0 +1,73 @@
+"""``sremu bench --suite {b1..b6,eb3} [suite args...]`` (WP11; DESIGN.md sections 2.5, 12).
+
+Runs a benchmark suite of the repository's ``bench/`` directory (``python -m
+bench.<module>`` with the current interpreter, working directory = the repository root, in
+the deterministic numba environment the CLI has already set). Extra arguments are passed to
+the suite unchanged, e.g. ``sremu bench --suite b2 --quick --out runs/bench``. The suites
+exist only in a source checkout; an installed wheel has no ``bench/`` (exit code 3).
+
+| Suite | Module | What |
+|---|---|---|
+| b1 | ``bench.b1_kernels`` | kernel micro-benchmarks and the section 7.4 cost-model fit |
+| b2 | ``bench.b2_lockstep`` | lockstep RTF slices (links, cells, RIS count, rate, features) |
+| b3 | ``bench.b3_paced`` | paced sustainable links and latency CDFs (Linux numbers) |
+| b4 | ``bench.b4_control`` | control loop: lockstep (lateness 0) and paced async |
+| b5 | ``bench.b5_v1`` | the v1 Fig. 3 workload, v1 vs sremu on the same host |
+| b6 | ``bench.b6_crosstool`` | cross-tool context (MATLAB, RISReflector, v2) |
+| eb3 | ``bench.eb3_paced`` | E-B3 timing demonstration (external TDMA controller) |
+"""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+import typer
+
+__all__ = ["SUITES", "app", "bench_dir", "command", "run_suite"]
+
+SUITES: dict[str, str] = {
+    "b1": "bench.b1_kernels",
+    "b2": "bench.b2_lockstep",
+    "b3": "bench.b3_paced",
+    "b4": "bench.b4_control",
+    "b5": "bench.b5_v1",
+    "b6": "bench.b6_crosstool",
+    "eb3": "bench.eb3_paced",
+}
+"""Suite name -> module under the repository's ``bench/`` package."""
+
+
+def bench_dir() -> Path | None:
+    """The repository root holding ``bench/`` (source checkout), or None."""
+    root = Path(__file__).resolve().parents[3]
+    return root if (root / "bench" / "__init__.py").exists() else None
+
+
+app = typer.Typer(add_completion=False, pretty_exceptions_enable=False)
+
+
+@app.command(
+    context_settings={"allow_extra_args": True, "ignore_unknown_options": True},
+    help="Benchmarks (b1..b6, eb3) with platform capture; extra arguments go to the suite.",
+)
+def run_suite(
+    ctx: typer.Context,
+    suite: str = typer.Option(..., "--suite", help="b1 | b2 | b3 | b4 | b5 | b6 | eb3"),
+) -> None:
+    """Run one benchmark suite."""
+    if suite not in SUITES:
+        typer.echo(f"sremu bench: unknown suite {suite!r} ({', '.join(SUITES)})", err=True)
+        raise typer.Exit(2)
+    root = bench_dir()
+    if root is None:
+        typer.echo("sremu bench: the bench/ suites need a source checkout of sremu", err=True)
+        raise typer.Exit(3)
+    rc = subprocess.call([sys.executable, "-m", SUITES[suite], *ctx.args], cwd=root)
+    if rc:
+        raise typer.Exit(rc)
+
+
+command = typer.main.get_command(app)
+"""The click command registered as ``sremu bench`` (passes unknown options to the suite)."""
diff --git a/tests/bench/__init__.py b/tests/bench/__init__.py
new file mode 100644
index 0000000000000000000000000000000000000000..e69de29bb2d1d6434b8b29ae775ad8c2e48c5391
diff --git a/tests/bench/test_bench_aws.py b/tests/bench/test_bench_aws.py
new file mode 100644
index 0000000000000000000000000000000000000000..d07af89cc119edfa205d2c96c07eb82bab72e56d
--- /dev/null
+++ b/tests/bench/test_bench_aws.py
@@ -0,0 +1,247 @@
+"""WP11 AWS bundle: console channel end to end, user-data rendering, packing (DESIGN 12.4).
+
+The console channel is simulated without AWS: results -> pack_results -> console_stream
+framing -> fake ``GetConsoleOutput`` snapshots (noise lines, partial windows, a corrupted
+chunk, JSON-wrapped and plain text) -> collect_console reassembly, CRC and SHA-256 checks,
+safe extraction. The shell logic of user_data.sh is checked for syntax here; the full
+dry run in WSL2/Linux is ``bench/aws/dryrun_local.py``.
+"""
+
+from __future__ import annotations
+
+import base64
+import io
+import json
+import shutil
+import subprocess
+import tarfile
+from pathlib import Path
+
+import numpy as np
+import pytest
+from bench.aws import collect_console as cc
+from bench.aws import console_stream as cs
+from bench.aws import make_bundle as mb
+from bench.aws import pack_results as pr
+from bench.aws import run_job as rj
+
+pytestmark = pytest.mark.unit
+
+SHA = "a" * 64
+URL = (
+    "https://bkt.s3.eu-west-1.amazonaws.com/sremu_bundle.tar.gz?X-Amz-Algorithm=AWS4-HMAC-SHA256"
+    "&X-Amz-Credential=AKIAEXAMPLE%2F20261010%2Feu-west-1%2Fs3%2Faws4_request&X-Amz-Expires=900"
+    "&X-Amz-Signature=0123abcd"
+)
+
+
+def _results(tmp: Path) -> Path:
+    root = tmp / "out"
+    run = root / "20261010T000000Z_b3"
+    run.mkdir(parents=True)
+    for name in ("manifest.json", "meta.json", "summary.json", "spec.json"):
+        (run / name).write_text(json.dumps({"name": name}), encoding="utf-8")
+    (run / "points.csv").write_bytes(np.random.default_rng(0).bytes(20_000))  # incompressible
+    (run / "dirty.patch").write_bytes(b"x" * 300_000)
+    (root / "status.json").write_text('{"rc": 0}', encoding="utf-8")
+    return root
+
+
+def _snapshots(lines: list[str], window: int, step: int) -> list[str]:
+    """Overlapping 'most recent output' windows with console noise interleaved."""
+    noisy = []
+    for i, ln in enumerate(lines):
+        if i % 7 == 0:
+            noisy.append(f"[  {i}.000000] kernel: some message")
+        noisy.append(ln)
+    return [
+        "\r\n".join(noisy[max(0, k - window) : k]) for k in range(step, len(noisy) + step, step)
+    ]
+
+
+def test_console_channel_end_to_end(tmp_path: Path) -> None:
+    blob, info = pr.pack(_results(tmp_path), max_bytes=2_000_000)
+    assert info["fits"]
+    lines = [ln for ln, _ in cs.stream_lines("b3_paced", blob, passes=3, pause_s=0)]
+    assert all(len(ln) <= cs.MAX_LINE for ln in lines)
+    assert lines[-1] == cs.DONE and lines[-2].startswith("SREMU-END|b3_paced|")
+    n = int(lines[0].split("|")[2])
+    # corrupt chunk 1 of the first pass (CRC must reject it; a later pass repairs it)
+    bad = lines[2].split("|")
+    bad[-1] = base64.b64encode(b"corrupted" * 10).decode()
+    lines[2] = "|".join(bad)
+    snaps = _snapshots(lines, window=6, step=4)
+    # every second snapshot is the JSON reply of GetConsoleOutput (base64 'Output')
+    texts = []
+    for i, s in enumerate(snaps):
+        if i % 2:
+            raw = json.dumps({"InstanceId": "i-0", "Output": base64.b64encode(s.encode()).decode()})
+            texts.append(cc.snapshot_text(raw.encode()))
+        else:
+            texts.append(cc.snapshot_text(s.encode()))
+    jobs = cc.parse(texts, "b3_paced")
+    jc = jobs["b3_paced"]
+    assert jc.n == n and jc.complete() and jc.bad_crc >= 1 and jc.done_seen and jc.end_seen
+    data = cc.assemble(jc)
+    assert data == blob
+    arc = tmp_path / "r.tar.gz"
+    arc.write_bytes(data)
+    names = cc.safe_extract(arc, tmp_path / "x")
+    assert "20261010T000000Z_b3/manifest.json" in names and "PACK_INDEX.json" in names
+    idx = json.loads((tmp_path / "x" / "PACK_INDEX.json").read_text())
+    assert idx["files"]["20261010T000000Z_b3/dirty.patch"]["included"] is False
+
+
+def test_collect_reports_missing_and_conflicts(tmp_path: Path) -> None:
+    blob = bytes(range(256)) * 50
+    lines = [ln for ln, _ in cs.stream_lines("smoke", blob, passes=1, pause_s=0)]
+    chunks = [ln for ln in lines if ln.startswith("SREMU|")]
+    assert len(chunks) >= 2
+    partial = "\n".join([lines[0], *chunks[1:]])
+    jc = cc.parse([partial])["smoke"]
+    assert not jc.complete() and jc.missing() == [0]
+    with pytest.raises(ValueError, match="incomplete"):
+        cc.assemble(jc)
+    # a different valid chunk 0 for the same index is a conflict
+    other = cs.frame("smoke", b"Z" * len(blob))[0][0]
+    jc2 = cc.parse(["\n".join([*lines, other])])["smoke"]
+    with pytest.raises(ValueError, match="conflicting"):
+        cc.assemble(jc2)
+    # CLI: incomplete -> exit 2
+    snap = tmp_path / "snap.txt"
+    snap.write_text(partial, encoding="utf-8")
+    assert cc.main([str(snap), "--job", "smoke", "--out", str(tmp_path / "o")]) == 2
+
+
+def test_safe_extract_refuses_traversal(tmp_path: Path) -> None:
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
+        ti = tarfile.TarInfo("../evil.txt")
+        ti.size = 1
+        tf.addfile(ti, io.BytesIO(b"x"))
+    arc = tmp_path / "evil.tar.gz"
+    arc.write_bytes(buf.getvalue())
+    with pytest.raises(ValueError, match="unsafe"):
+        cc.safe_extract(arc, tmp_path / "dest")
+    assert not (tmp_path / "evil.txt").exists()
+
+
+def test_pack_is_deterministic_and_fits_budget(tmp_path: Path) -> None:
+    root = _results(tmp_path)
+    a, _ = pr.pack(root, max_bytes=2_000_000)
+    b, _ = pr.pack(root, max_bytes=2_000_000)
+    assert a == b
+    small, info = pr.pack(root, max_bytes=3_000)
+    assert info["fits"] and len(small) <= 3_000
+    with tarfile.open(fileobj=io.BytesIO(small), mode="r:gz") as tf:
+        names = tf.getnames()
+    assert "20261010T000000Z_b3/manifest.json" in names  # essentials kept
+    assert "20261010T000000Z_b3/points.csv" not in names  # largest non-essential dropped
+
+
+def test_render_user_data_fills_placeholders_and_checks_inputs() -> None:
+    text = mb.render("b3_paced", URL, SHA, 130)
+    for key in (
+        "__BUNDLE_URL__",
+        "__BUNDLE_SHA256__",
+        "__JOB__",
+        "__MAXMIN__",
+        "__CONSOLE_STREAM_PY__",
+    ):
+        assert key not in text
+    assert '"${SREMU_JOB:-b3_paced}"' in text and f'"${{SREMU_BUNDLE_SHA256:-{SHA}}}"' in text
+    assert 'shutdown -h "+$MAXMIN"' in text
+    assert text.index("shutdown -h") < text.index("curl ")  # hard cap before anything else
+    assert "def frame(" in text  # console streamer embedded
+    assert len(text.encode()) <= mb.USER_DATA_LIMIT
+    for bad in (
+        {"job": "b9", "url": URL, "sha256": SHA, "maxmin": 60},
+        {"job": "smoke", "url": "http://x/y", "sha256": SHA, "maxmin": 60},
+        {"job": "smoke", "url": "file:///tmp/b.tgz", "sha256": SHA, "maxmin": 60},
+        {"job": "smoke", "url": URL + "$(reboot)", "sha256": SHA, "maxmin": 60},
+        {"job": "smoke", "url": URL, "sha256": "xyz", "maxmin": 60},
+        {"job": "smoke", "url": URL, "sha256": SHA, "maxmin": 5},
+    ):
+        with pytest.raises(ValueError):
+            mb.render(**bad)  # type: ignore[arg-type]
+    assert mb.render("selftest", "file:///tmp/b.tgz", SHA, 30, allow_file_url=True)
+
+
+@pytest.mark.skipif(shutil.which("bash") is None, reason="bash not available")
+def test_user_data_shell_syntax() -> None:
+    text = mb.render("smoke", URL, SHA, 45)
+    # script on stdin: works for Git Bash, Linux bash and the WSL bash.exe alike
+    r = subprocess.run(["bash", "-n", "-s"], input=text.encode(), capture_output=True, timeout=120)
+    assert r.returncode == 0, r.stderr.decode(errors="replace")
+
+
+def test_bundle_tar_is_deterministic() -> None:
+    entries = {"b/x.py": b"print(1)\n", "a/run.sh": b"#!/bin/sh\n", "BUNDLE_MANIFEST.json": b"{}"}
+    t1 = mb.build_tar(entries)
+    t2 = mb.build_tar(dict(reversed(list(entries.items()))))
+    assert t1 == t2
+    with tarfile.open(fileobj=io.BytesIO(t1), mode="r:gz") as tf:
+        modes = {m.name: m.mode for m in tf.getmembers()}
+        assert modes["a/run.sh"] == 0o755 and modes["b/x.py"] == 0o644
+        assert all(m.mtime == 0 and m.uid == 0 for m in tf.getmembers())
+
+
+def test_run_job_commands_cover_every_job(tmp_path: Path) -> None:
+    for job in rj.JOBS:
+        cmds = rj.commands(job, tmp_path, "py", "pyv1", 85.0)
+        for c in cmds:
+            assert c[0] == "py" and c[1] == "-m" and c[2].startswith("bench.")
+            assert "--out" in c
+    assert rj.commands("selftest", tmp_path, "py", "pyv1", 85.0) == []
+    b5 = rj.commands("b5_v1_vs_sremu", tmp_path, "py", "pyv1", 85.0)[0]
+    assert b5[b5.index("--v1-python") + 1] == "pyv1"
+    with pytest.raises(SystemExit):
+        rj.commands("nope", tmp_path, "py", "pyv1", 85.0)
