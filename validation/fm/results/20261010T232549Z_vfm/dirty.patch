+        q = np.quantile(sig, [0.05, 0.5, 0.95])
+        out["ris_signature_db"] = {"q05": float(q[0]), "median": float(q[1]), "q95": float(q[2])}
+        rr = ring_removed(p[:, :, i2], test, ring)
+        out["ring_removed_m2_sd_db"] = float(np.median(np.std(rr, axis=0, ddof=1)))
     return out
 
 
