+"""AWS bundle for the Linux benchmark jobs (DESIGN.md section 12.4; WP11).
+
+No IAM role, no SSH, no security-group changes: the instance downloads a bundle from a
+pre-signed URL, runs one job, and returns its (small) results through the EC2 serial
+console as framed base64 lines, which :mod:`bench.aws.collect_console` reassembles from saved
+``GetConsoleOutput`` snapshots. See ``bench/aws/TEARDOWN.md``.
+
+The modules ``console_stream``, ``pack_results`` and ``collect_console`` use only the
+Python standard library (they run with the system ``python3`` on the instance and with any
+Python on the collecting machine).
+"""
diff --git a/bench/aws/collect_console.py b/bench/aws/collect_console.py
new file mode 100644
index 0000000000000000000000000000000000000000..f83182921789e31a19cdf7d7d268e1eb7f6bdf95
--- /dev/null
+++ b/bench/aws/collect_console.py
@@ -0,0 +1,243 @@
+#!/usr/bin/env python3
+"""Reassemble a job's results from saved EC2 ``GetConsoleOutput`` snapshots (stdlib only).
+
+Usage::
+
+    python bench/aws/collect_console.py SNAP1 [SNAP2 ...] [--job b3_paced] [--out DIR]
+
+Each SNAP is either the JSON reply of ``GetConsoleOutput`` (its ``Output`` field is base64
+and is decoded) or plain console text. Every line is scanned for the framing of
+:mod:`console_stream`; a chunk is accepted only if its CRC-32 matches, and the same index
+seen in several snapshots or passes must carry identical bytes. When every chunk ``0..n-1``
+is present, the bytes are joined, their length and SHA-256 are checked against the
+``SREMU-META`` line, the archive is written to ``<out>/<job>_results.tar.gz`` and safely
+extracted to ``<out>/<job>/`` (absolute paths, ``..`` components, links and devices are
+refused). Exit codes: 0 complete and verified, 2 incomplete (the missing indices are
+printed: poll the console again), 1 inconsistent or corrupt.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import binascii
+import hashlib
+import json
+import re
+import sys
+import tarfile
+import zlib
+from dataclasses import dataclass, field
+from pathlib import Path, PurePosixPath
+
+try:  # package import (tests) or script import (on the collecting machine)
+    from bench.aws.console_stream import CHUNK_RE, DONE, END_RE, META_RE
+except ImportError:  # pragma: no cover - script use
+    sys.path.insert(0, str(Path(__file__).resolve().parent))
+    from console_stream import CHUNK_RE, DONE, END_RE, META_RE  # type: ignore[no-redef]
+
+
+@dataclass
+class JobChunks:
+    """What the snapshots carried for one job."""
+
+    job: str
+    n: int | None = None
+    nbytes: int | None = None
+    sha256: str | None = None
+    chunks: dict[int, bytes] = field(default_factory=dict)
+    bad_crc: int = 0
+    duplicates: int = 0
+    conflicts: list[int] = field(default_factory=list)
+    done_seen: bool = False
+    end_seen: bool = False
+
+    def missing(self) -> list[int]:
+        """Chunk indices not yet received (all of them when ``n`` is unknown)."""
+        if self.n is None:
+            return []
+        return [i for i in range(self.n) if i not in self.chunks]
+
+    def complete(self) -> bool:
+        """Every chunk present and the META line seen."""
+        return self.n is not None and self.sha256 is not None and not self.missing()
+
+
+def snapshot_text(raw: bytes) -> str:
+    """Console text of one saved snapshot: the GetConsoleOutput JSON reply (its ``Output``
+    base64 as returned by the EC2 API, or already decoded as boto3 returns it) or plain
+    text. ``Output`` is base64-decoded only when it is strictly valid base64; an already
+    decoded console text (it contains line breaks, ``|`` or spaces) is used as it is."""
+    text = raw.decode("utf-8", errors="replace")
+    s = text.lstrip()
+    if s.startswith("{"):
+        try:
+            d = json.loads(s)
+        except json.JSONDecodeError:
+            return text
+        out = d.get("Output")
+        if isinstance(out, str):
+            packed = "".join(out.split())
+            if not _B64_RE.fullmatch(packed) or len(packed) % 4:
+                return out  # already decoded (boto3 decodes the console output)
+            try:
+                return base64.b64decode(packed, validate=True).decode("utf-8", errors="replace")
+            except (binascii.Error, ValueError):
+                return out
+    return text
+
+
+_B64_RE = re.compile(r"[A-Za-z0-9+/]+={0,2}")
+
+
+def parse(texts: list[str], job: str | None = None) -> dict[str, JobChunks]:
+    """Scan console texts; returns per-job chunk state."""
+    jobs: dict[str, JobChunks] = {}
+
+    def get(name: str) -> JobChunks:
+        return jobs.setdefault(name, JobChunks(name))
+
+    done = False
+    for text in texts:
+        for line in text.replace("\r", "\n").split("\n"):
+            if line.strip().endswith(DONE):
+                done = True
+                continue
+            m = META_RE.search(line)
+            if m:
+                if job is not None and m["job"] != job:
+                    continue
+                jc = get(m["job"])
+                n, nb, sha = int(m["n"]), int(m["nbytes"]), m["sha"]
+                if jc.n is not None and (jc.n, jc.nbytes, jc.sha256) != (n, nb, sha):
+                    jc.conflicts.append(-1)
+                jc.n, jc.nbytes, jc.sha256 = n, nb, sha
+                continue
+            m = END_RE.search(line)
+            if m:
+                if job is None or m["job"] == job:
+                    get(m["job"]).end_seen = True
+                continue
+            m = CHUNK_RE.search(line)
+            if not m or (job is not None and m["job"] != job):
+                continue
+            jc = get(m["job"])
+            try:
+                data = base64.b64decode(m["b64"], validate=True)
+            except (binascii.Error, ValueError):
+                jc.bad_crc += 1
+                continue
+            if f"{zlib.crc32(data) & 0xFFFFFFFF:08x}" != m["crc"]:
+                jc.bad_crc += 1
+                continue
+            i, n = int(m["i"]), int(m["n"])
+            if jc.n is not None and n != jc.n:
+                jc.conflicts.append(i)
+                continue
+            if i in jc.chunks:
+                jc.duplicates += 1
+                if jc.chunks[i] != data:
+                    jc.conflicts.append(i)
+                continue
+            jc.chunks[i] = data
+    for jc in jobs.values():
+        jc.done_seen = done
+    return jobs
+
+
+def assemble(jc: JobChunks) -> bytes:
+    """Joined bytes of a complete job; raises ``ValueError`` on any inconsistency."""
+    if jc.conflicts:
+        raise ValueError(f"{jc.job}: conflicting chunks or META lines: {sorted(set(jc.conflicts))}")
+    if not jc.complete():
+        raise ValueError(f"{jc.job}: incomplete; missing {jc.missing()[:50]}")
+    assert jc.n is not None
+    data = b"".join(jc.chunks[i] for i in range(jc.n))
+    if jc.nbytes is not None and len(data) != jc.nbytes:
+        raise ValueError(f"{jc.job}: {len(data)} bytes != META {jc.nbytes}")
+    sha = hashlib.sha256(data).hexdigest()
+    if sha != jc.sha256:
+        raise ValueError(f"{jc.job}: SHA-256 {sha} != META {jc.sha256}")
+    return data
+
+
+def safe_extract(archive: Path, dest: Path) -> list[str]:
+    """Extract a tar.gz refusing absolute paths, ``..``, links and special files."""
+    dest.mkdir(parents=True, exist_ok=True)
+    names = []
+    with tarfile.open(archive, "r:gz") as tf:
+        members = tf.getmembers()
+        for m in members:
+            p = PurePosixPath(m.name)
+            if p.is_absolute() or ".." in p.parts or m.name.startswith(("/", "\\")):
+                raise ValueError(f"unsafe path in archive: {m.name!r}")
+            if not (m.isfile() or m.isdir()):
+                raise ValueError(f"refusing non-regular member {m.name!r}")
+        for m in members:
+            target = dest.joinpath(*PurePosixPath(m.name).parts)
+            if m.isdir():
+                target.mkdir(parents=True, exist_ok=True)
+                continue
+            target.parent.mkdir(parents=True, exist_ok=True)
+            src = tf.extractfile(m)
+            assert src is not None
+            target.write_bytes(src.read())
+            names.append(m.name)
+    return names
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Command-line entry point."""
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("snapshots", nargs="+", type=Path)
+    ap.add_argument("--job", default=None)
+    ap.add_argument("--out", type=Path, default=Path("runs") / "aws_results")
+    a = ap.parse_args(argv)
+    texts = [snapshot_text(p.read_bytes()) for p in a.snapshots]
+    jobs = parse(texts, a.job)
+    if not jobs:
+        print("no SREMU framing found in the snapshots")
+        return 2
+    rc = 0
+    for name, jc in sorted(jobs.items()):
+        status = {
+            "job": name,
+            "n": jc.n,
+            "received": len(jc.chunks),
+            "missing": jc.missing()[:200],
+            "bad_crc_lines": jc.bad_crc,
+            "duplicates": jc.duplicates,
+            "end_seen": jc.end_seen,
+            "done_seen": jc.done_seen,
+        }
+        if not jc.complete():
+            print(json.dumps({**status, "status": "incomplete"}))
+            rc = max(rc, 2)
+            continue
+        try:
+            data = assemble(jc)
+        except ValueError as exc:
+            print(json.dumps({**status, "status": "error", "error": str(exc)}))
+            rc = 1
+            continue
+        a.out.mkdir(parents=True, exist_ok=True)
+        arc = a.out / f"{name}_results.tar.gz"
+        arc.write_bytes(data)
+        files = safe_extract(arc, a.out / name)
+        print(
+            json.dumps(
+                {
+                    **status,
+                    "status": "complete",
+                    "sha256": jc.sha256,
+                    "bytes": len(data),
+                    "archive": str(arc),
+                    "files": len(files),
+                }
+            )
+        )
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/aws/console_stream.py b/bench/aws/console_stream.py
new file mode 100644
index 0000000000000000000000000000000000000000..9ef9f6fe18f00d0d7e92037fca0e7693399b942c
--- /dev/null
+++ b/bench/aws/console_stream.py
@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""Stream a file over the serial console as framed base64 lines (stdlib only).
+
+Framing (one record per line, every line <= ``MAX_LINE`` = 3000 characters):
+
+* ``SREMU-META|<job>|<n>|<nbytes>|<sha256>|<pass>/<passes>`` before each pass;
+* ``SREMU|<job>|<i>|<n>|<crc32>|<b64>`` for chunk ``i`` in ``0..n-1``: ``crc32`` is the
+  8-hex-digit CRC-32 (``zlib.crc32``) of the chunk's raw bytes, ``b64`` their base64;
+* ``SREMU-END|<job>|<sha256>`` after the last pass, then ``SREMU-DONE``.
+
+The whole chunk sequence is written ``passes`` times (default 3) with ``pause_s`` (20 s)
+between passes, so a reader that polls ``GetConsoleOutput`` (which returns only the most
+recent output) can collect every chunk; ``bps`` throttles the output (characters per
+second) so that consecutive console snapshots overlap. ``<job>`` matches ``[A-Za-z0-9_]+``.
+
+Usage on the instance::
+
+    python3 console_stream.py --job b3_paced --file results.tar.gz > /dev/ttyS0
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import re
+import sys
+import time
+import zlib
+from collections.abc import Callable, Iterator
+from typing import TextIO
+
+MAX_LINE = 3000
+JOB_RE = re.compile(r"^[A-Za-z0-9_]+$")
+CHUNK_RE = re.compile(
+    r"SREMU\|(?P<job>[A-Za-z0-9_]+)\|(?P<i>\d+)\|(?P<n>\d+)\|(?P<crc>[0-9a-f]{8})\|(?P<b64>[A-Za-z0-9+/=]+)"
+)
+META_RE = re.compile(
+    r"SREMU-META\|(?P<job>[A-Za-z0-9_]+)\|(?P<n>\d+)\|(?P<nbytes>\d+)\|(?P<sha>[0-9a-f]{64})"
+)
+END_RE = re.compile(r"SREMU-END\|(?P<job>[A-Za-z0-9_]+)\|(?P<sha>[0-9a-f]{64})")
+DONE = "SREMU-DONE"
+
+
+def chunk_size(job: str, n_guess: int, max_line: int = MAX_LINE) -> int:
+    """Raw bytes per chunk so that the longest chunk line fits in ``max_line``."""
+    digits = len(str(max(n_guess, 1)))
+    prefix = len(f"SREMU|{job}|") + 2 * digits + 2 + 8 + 1
+    b64 = (max_line - prefix) // 4 * 4
+    if b64 < 4:
+        raise ValueError("max_line too small")
+    return b64 // 4 * 3
+
+
+def frame(job: str, data: bytes, max_line: int = MAX_LINE) -> tuple[list[str], str]:
+    """Chunk lines of ``data`` and its SHA-256 hex."""
+    if not JOB_RE.match(job):
+        raise ValueError(f"job name {job!r} must match [A-Za-z0-9_]+")
+    size = chunk_size(job, 10**7, max_line)  # 8 digits: valid for any realistic n
+    n = max(1, -(-len(data) // size))
+    lines = []
+    for i in range(n):
+        part = data[i * size : (i + 1) * size]
+        crc = zlib.crc32(part) & 0xFFFFFFFF
+        line = f"SREMU|{job}|{i}|{n}|{crc:08x}|{base64.b64encode(part).decode('ascii')}"
+        if len(line) > max_line:  # pragma: no cover - guarded by chunk_size
+            raise AssertionError("line too long")
+        lines.append(line)
+    return lines, hashlib.sha256(data).hexdigest()
+
+
+def stream_lines(
+    job: str,
+    data: bytes,
+    *,
+    passes: int = 3,
+    pause_s: float = 20.0,
+    max_line: int = MAX_LINE,
+) -> Iterator[tuple[str, float]]:
+    """``(line, pause_after_s)`` pairs of the complete transmission (all passes)."""
+    lines, sha = frame(job, data, max_line)
+    for p in range(passes):
+        yield f"SREMU-META|{job}|{len(lines)}|{len(data)}|{sha}|{p + 1}/{passes}", 0.0
+        for ln in lines:
+            yield ln, 0.0
+        if p + 1 < passes:
+            yield f"SREMU-LOG|{job}|pass {p + 1} of {passes} done; pausing {pause_s:g} s", pause_s
+    yield f"SREMU-END|{job}|{sha}", 0.0
+    yield DONE, 0.0
+
+
+def stream(
+    job: str,
+    data: bytes,
+    out: TextIO,
+    *,
+    passes: int = 3,
+    pause_s: float = 20.0,
+    bps: float = 8000.0,
+    max_line: int = MAX_LINE,
+    sleep: Callable[[float], None] = time.sleep,
+) -> int:
+    """Write the transmission to ``out`` (flushed per line), throttled to ``bps`` characters
+    per second; returns the number of lines written."""
+    k = 0
+    for line, pause in stream_lines(job, data, passes=passes, pause_s=pause_s, max_line=max_line):
+        out.write(line + "\n")
+        out.flush()
+        k += 1
+        if bps > 0:
+            sleep((len(line) + 1) / bps)
+        if pause > 0:
+            sleep(pause)
+    return k
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Command-line entry point."""
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--job", required=True)
+    ap.add_argument("--file", required=True)
+    ap.add_argument("--passes", type=int, default=3)
+    ap.add_argument("--pause-s", type=float, default=20.0)
+    ap.add_argument(
+        "--bps", type=float, default=8000.0, help="characters per second (0: no throttle)"
+    )
+    ap.add_argument("--max-line", type=int, default=MAX_LINE)
+    a = ap.parse_args(argv)
+    with open(a.file, "rb") as fh:
+        data = fh.read()
+    stream(
+        a.job, data, sys.stdout, passes=a.passes, pause_s=a.pause_s, bps=a.bps, max_line=a.max_line
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/aws/dryrun_local.py b/bench/aws/dryrun_local.py
new file mode 100644
index 0000000000000000000000000000000000000000..01f744fdf7bb1d47388083f4874cae938abdb8b5
--- /dev/null
+++ b/bench/aws/dryrun_local.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Local dry run of the whole AWS path in WSL2 or local Linux (no AWS involved).
+
+Usage::
+
+    python bench/aws/dryrun_local.py [--job selftest|smoke] [--shell wsl|bash] [--out DIR]
+
+1. builds the bundle (:func:`make_bundle.build`) into ``--out``;
+2. renders ``user_data.sh`` for ``--job`` with a ``file://`` bundle URL;
+3. runs it with ``SREMU_DRYRUN=1`` (no shutdown, no poweroff), ``SREMU_SKIP_APT=1``,
+   ``SREMU_PYTHON=python3``, a temporary ``SREMU_ROOT`` and ``SREMU_CONSOLE`` = a file,
+   unthrottled streaming with 1 s pauses; under ``wsl`` the paths are translated to
+   ``/mnt/<drive>/...`` and the root lives in the WSL ``/tmp``;
+4. reassembles the console file with :mod:`collect_console` and checks the CRCs, the
+   SHA-256 and the unpacked files (``status.json``/``sysinfo.json`` for every job).
+
+``selftest`` exercises download, checksum, extraction, pinning, packing and the console
+channel without installing anything; ``smoke`` additionally creates the venv from
+``requirements-aws.txt`` (network access to PyPI) and runs the quick B2/B3 suites.
+Writes ``dryrun_<job>.json`` with the outcome into ``--out``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import collect_console as cc  # noqa: E402
+import make_bundle as mb  # noqa: E402
+
+
+def wsl_path(p: Path) -> str:
+    """``D:\\a\\b`` -> ``/mnt/d/a/b``."""
+    s = str(p.resolve())
+    if len(s) > 1 and s[1] == ":":
+        return f"/mnt/{s[0].lower()}{s[2:].replace(chr(92), '/')}"
+    return s.replace("\\", "/")
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Command-line entry point."""
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--job", default="selftest", choices=("selftest", "smoke"))
+    ap.add_argument(
+        "--shell", default="wsl" if shutil.which("wsl.exe") else "bash", choices=("wsl", "bash")
+    )
+    ap.add_argument("--out", type=Path, default=mb.REPO / "runs" / "aws_dryrun")
+    ap.add_argument("--no-v1", action="store_true")
+    ap.add_argument("--timeout-s", type=float, default=3600.0)
+    a = ap.parse_args(argv)
+    a.out.mkdir(parents=True, exist_ok=True)
+    info = mb.build(a.out, None if a.no_v1 else mb.V1_DEFAULT)
+    bundle = Path(str(info["bundle"]))
+    tag = time.strftime("%Y%m%dT%H%M%S")
+    if a.shell == "wsl":
+        url = "file://" + wsl_path(bundle)
+        root = f"/tmp/sremu_dry_{tag}"
+    else:
+        url = bundle.resolve().as_uri()
+        root = str(a.out / f"root_{tag}")
+    ud = a.out / f"user_data_{a.job}.sh"
+    ud.write_text(
+        mb.render(a.job, url, str(info["sha256"]), 60, allow_file_url=True),
+        encoding="utf-8",
+        newline="\n",
+    )
+    env = {
+        "SREMU_DRYRUN": "1",
+        "SREMU_SKIP_APT": "1",
+        "SREMU_PYTHON": "python3",
+        "SREMU_ROOT": root,
+        "SREMU_CONSOLE": f"{root}/console.txt",
+        "SREMU_STREAM_BPS": "0",
+        "SREMU_STREAM_PAUSE": "1",
+        "SREMU_RESERVE_MIN": "5",
+    }
+    assign = " ".join(f"{k}={v}" for k, v in env.items())
+    script = wsl_path(ud) if a.shell == "wsl" else str(ud)
+    inner = (
+        f"mkdir -p {root} && {assign} bash {script}; echo USERDATA_RC=$?; cat {root}/console.txt"
+    )
+    cmd = ["wsl.exe", "-e", "bash", "-c", inner] if a.shell == "wsl" else ["bash", "-c", inner]
+    t0 = time.perf_counter()
+    r = subprocess.run(cmd, capture_output=True, timeout=a.timeout_s)
+    wall = time.perf_counter() - t0
+    out = r.stdout.decode("utf-8", errors="replace").replace("\x00", "")
+    (a.out / f"console_{a.job}.txt").write_text(out, encoding="utf-8")
+    jobs = cc.parse([out], a.job)
+    jc = jobs.get(a.job)
+    result: dict[str, object] = {
+        "job": a.job,
+        "shell": a.shell,
+        "wall_s": wall,
+        "bundle": info,
+        "userdata_rc_line": next(
+            (ln for ln in out.splitlines() if ln.startswith("USERDATA_RC=")), None
+        ),
+        "log_lines": [ln for ln in out.splitlines() if ln.startswith("SREMU-LOG|")][-40:],
+    }
+    if jc is None or not jc.complete():
+        result["status"] = "incomplete"
+        result["missing"] = None if jc is None else jc.missing()
+        result["stderr"] = r.stderr.decode("utf-8", errors="replace")[-3000:]
+    else:
+        data = cc.assemble(jc)
+        arc = a.out / f"{a.job}_results.tar.gz"
+        arc.write_bytes(data)
+        files = cc.safe_extract(arc, a.out / f"{a.job}_results")
+        result.update(
+            status="complete",
+            sha256=jc.sha256,
+            bytes=len(data),
+            files=files,
+            chunks=jc.n,
+            duplicates=jc.duplicates,
+            done_seen=jc.done_seen,
+        )
+        st = a.out / f"{a.job}_results" / "status.json"
+        if st.exists():
+            result["job_status"] = json.loads(st.read_text(encoding="utf-8"))
+    (a.out / f"dryrun_{a.job}.json").write_text(
+        json.dumps(result, indent=1, default=str), encoding="utf-8"
+    )
+    print(json.dumps({k: result[k] for k in ("job", "status", "wall_s", "userdata_rc_line")}))
+    return 0 if result["status"] == "complete" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
