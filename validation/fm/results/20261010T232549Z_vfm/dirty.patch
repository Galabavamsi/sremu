index 0000000000000000000000000000000000000000..63eb99889b2dbde3141eba9c2adeed1d69d4abd5
--- /dev/null
+++ b/bench/aws/make_bundle.py
@@ -0,0 +1,306 @@
+#!/usr/bin/env python3
+"""Build the AWS job bundle and render the user data (DESIGN.md 12.4; WP11).
+
+Usage::
+
+    python bench/aws/make_bundle.py build [--out runs/aws_bundle] [--v1-dir DIR] [--require-clean]
+    python bench/aws/make_bundle.py render --job JOB --url URL --sha256 SHA --maxmin MIN
+                                           [-o user_data.rendered.sh] [--allow-file-url]
+
+**build** writes ``sremu_bundle_<commit8>[_dirty].tar.gz`` plus ``.sha256`` and
+``bundle_info.json`` (outside the archive: creation time, sizes). The archive holds, under
+its root:
+
+* the git-tracked files of the sremu repository (``git ls-files``, read-only; working-tree
+  contents, so uncommitted edits to tracked files are included and the bundle is marked
+  ``_dirty``), excluding nothing else;
+* ``bench/`` in full (it may not be committed yet), without caches;
+* ``v1_bench/``: the patched v1 scratch copy for B5 (``bench.b5_v1.prepare_v1``: v1 as
+  committed plus the one import fix, and the reconstructed Fig. 3 generator), without
+  ``.git`` and caches;
+* ``BUNDLE_MANIFEST.json``: git commit and dirty flag, the v1 provenance, the untracked
+  files under ``src/``, ``scenarios/`` and ``data/`` (``untracked_not_included``, or
+  ``untracked_included`` with ``--include-untracked``), and every file with its size and
+  SHA-256.
+
+The archive is deterministic for given file contents (sorted entries, mtime 0, uid/gid 0,
+normalized modes, gzip mtime 0), so its SHA-256 identifies the content.
+
+**render** fills the placeholders of ``bench/aws/user_data.sh`` (``__BUNDLE_URL__``,
+``__BUNDLE_SHA256__``, ``__JOB__``, ``__MAXMIN__``) and embeds ``console_stream.py``; it
+refuses unknown jobs, non-https URLs (unless ``--allow-file-url``, for local dry runs),
+malformed SHA-256 values and a result larger than the 16 KB EC2 user-data limit.
+"""
+
+from __future__ import annotations
+
+import argparse
+import datetime as _dt
+import gzip
+import hashlib
+import io
+import json
+import re
+import shutil
+import subprocess
+import sys
+import tarfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+V1_DEFAULT = Path(r"D:\projects\ris\research\scratch\v1_bench")
+JOBS = (
+    "b3_paced",
+    "b4_paced",
+    "b5_v1_vs_sremu",
+    "b2_server_point",
+    "eb3_paced_controller",
+    "smoke",
+    "selftest",
+)
+USER_DATA_LIMIT = 16384
+_SKIP_PARTS = {
+    "__pycache__",
+    ".git",
+    ".pytest_cache",
+    ".mypy_cache",
+    ".ruff_cache",
+    ".hypothesis",
+    ".numba_cache",
+}
+
+
+def _git(*args: str) -> str:
+    git = shutil.which("git")
+    if git is None:
+        raise RuntimeError("git not found")
+    r = subprocess.run([git, "-C", str(REPO), *args], capture_output=True, timeout=60)
+    if r.returncode != 0:
+        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.decode(errors='replace')}")
+    return r.stdout.decode("utf-8")
+
+
+def tracked_files() -> list[str]:
+    """``git ls-files`` of the sremu repository (read-only)."""
+    return sorted(n for n in _git("ls-files", "-z").split("\0") if n)
+
+
+def untracked_files(paths: tuple[str, ...] = ("src", "scenarios", "data")) -> list[str]:
+    """Untracked, not ignored files under ``paths`` (``git ls-files --others``, read-only):
+    code or data the job may need that a bundle of tracked files would miss."""
+    out = _git("ls-files", "--others", "--exclude-standard", "-z", "--", *paths)
+    return sorted(n for n in out.split("\0") if n)
+
+
+def git_commit_dirty() -> tuple[str, bool]:
+    """HEAD and whether ``git status --porcelain`` lists anything (read-only)."""
+    return _git("rev-parse", "HEAD").strip(), bool(_git("status", "--porcelain").strip())
+
+
+def _walk(root: Path, prefix: str) -> dict[str, Path]:
+    out = {}
+    for p in sorted(root.rglob("*")):
+        rel = p.relative_to(root)
+        if any(part in _SKIP_PARTS for part in rel.parts) or not p.is_file():
+            continue
+        if p.suffix in (".pyc", ".pyo"):
+            continue
+        out[f"{prefix}{rel.as_posix()}"] = p
+    return out
+
+
+def collect(
+    v1_dir: Path | None, include_untracked: bool = False
+) -> tuple[dict[str, Path], dict[str, object]]:
+    """Archive name -> source path, and provenance facts."""
+    files: dict[str, Path] = {}
+    for name in tracked_files():
+        p = REPO / name
+        if p.is_file():
+            files[name] = p
+    files.update(_walk(REPO / "bench", "bench/"))
+    prov: dict[str, object] = {}
+    extra = untracked_files()
+    if include_untracked:
+        for name in extra:
+            if (REPO / name).is_file() and not any(
+                part in _SKIP_PARTS for part in Path(name).parts
+            ):
+                files[name] = REPO / name
+        prov["untracked_included"] = extra
+    else:
+        prov["untracked_not_included"] = extra
+    if v1_dir is not None:
+        if not (v1_dir / "ris_sim" / "core" / "engine.py").exists():
+            raise FileNotFoundError(
+                f"v1 scratch copy not found at {v1_dir} (run bench.b5_v1 first)"
+            )
+        fix = (v1_dir / "ris_sim" / "modules" / "channel_functions.py").read_text(encoding="utf-8")
+        if "import scipy.signal" not in fix:
+            raise RuntimeError(
+                "v1 scratch copy lacks the one import fix (run bench.b5_v1.prepare_v1)"
+            )
+        files.update(_walk(v1_dir, "v1_bench/"))
+        head = v1_dir / ".git" / "HEAD"
+        prov["v1_dir"] = str(v1_dir)
+        if head.exists():
+            ref = head.read_text().strip()
+            if ref.startswith("ref:"):
+                rp = v1_dir / ".git" / ref.split(None, 1)[1]
+                prov["v1_git_head"] = rp.read_text().strip() if rp.exists() else ref
+            else:
+                prov["v1_git_head"] = ref
+    return files, prov
+
+
+def build_tar(entries: dict[str, bytes]) -> bytes:
+    """Deterministic tar.gz of ``{name: bytes}`` (shell scripts executable)."""
+    raw = io.BytesIO()
+    with tarfile.open(fileobj=raw, mode="w", format=tarfile.PAX_FORMAT) as tf:
+        for name in sorted(entries):
+            data = entries[name]
+            ti = tarfile.TarInfo(name)
+            ti.size = len(data)
+            ti.mtime = 0
+            ti.mode = 0o755 if name.endswith(".sh") else 0o644
+            ti.uid = ti.gid = 0
+            ti.uname = ti.gname = ""
+            tf.addfile(ti, io.BytesIO(data))
+    out = io.BytesIO()
+    with gzip.GzipFile(fileobj=out, mode="wb", compresslevel=9, mtime=0) as gz:
+        gz.write(raw.getvalue())
+    return out.getvalue()
+
+
+def build(
+    out_dir: Path,
+    v1_dir: Path | None,
+    require_clean: bool = False,
+    include_untracked: bool = False,
+) -> dict[str, object]:
+    """Build the bundle; returns ``bundle_info``."""
+    commit, dirty = git_commit_dirty()
+    if dirty and require_clean:
+        raise RuntimeError("the sremu tree is dirty (--require-clean)")
+    files, prov = collect(v1_dir, include_untracked)
+    entries = {name: p.read_bytes() for name, p in files.items()}
+    manifest = {
+        "sremu_commit": commit,
+        "sremu_dirty": dirty,
+        **prov,
+        "files": {
+            n: {"bytes": len(b), "sha256": hashlib.sha256(b).hexdigest()}
+            for n, b in sorted(entries.items())
+        },
+    }
+    entries["BUNDLE_MANIFEST.json"] = json.dumps(manifest, indent=1, sort_keys=True).encode()
+    blob = build_tar(entries)
+    sha = hashlib.sha256(blob).hexdigest()
+    out_dir.mkdir(parents=True, exist_ok=True)
+    stem = f"sremu_bundle_{commit[:8]}{'_dirty' if dirty else ''}"
+    tgz = out_dir / f"{stem}.tar.gz"
+    tgz.write_bytes(blob)
+    (out_dir / f"{stem}.tar.gz.sha256").write_text(f"{sha}  {tgz.name}\n", encoding="utf-8")
+    info = {
+        "bundle": str(tgz),
+        "sha256": sha,
+        "bytes": len(blob),
+        "files": len(entries),
+        "sremu_commit": commit,
+        "sremu_dirty": dirty,
+        **prov,
+        "created_utc": _dt.datetime.now(_dt.UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
+    }
+    (out_dir / f"{stem}.bundle_info.json").write_text(json.dumps(info, indent=1), encoding="utf-8")
+    return info
+
+
+def render(
+    job: str,
+    url: str,
+    sha256: str,
+    maxmin: int,
+    *,
+    allow_file_url: bool = False,
+    template: Path = HERE / "user_data.sh",
+) -> str:
+    """Rendered user data (see the module docstring)."""
+    if job not in JOBS:
+        raise ValueError(f"unknown job {job!r}; one of {JOBS}")
+    if not re.fullmatch(r"[0-9a-f]{64}", sha256):
+        raise ValueError("sha256 must be 64 lowercase hex digits")
+    if not (url.startswith("https://") or (allow_file_url and url.startswith("file://"))):
+        raise ValueError("the bundle URL must be https:// (a pre-signed S3 URL)")
+    if any(c in url for c in "'\"`$\\{}\n\r "):
+        raise ValueError("the bundle URL contains characters unsafe in the shell script")
+    if not 15 <= int(maxmin) <= 600:
+        raise ValueError("maxmin must be within [15, 600] minutes")
+    text = template.read_text(encoding="utf-8").replace("\r\n", "\n")
+    stream_py = (HERE / "console_stream.py").read_text(encoding="utf-8").replace("\r\n", "\n")
+    if "SREMU_PY_EOF" in stream_py:
+        raise ValueError("console_stream.py must not contain the heredoc delimiter")
+    for key, val in (
+        ("__BUNDLE_URL__", url),
+        ("__BUNDLE_SHA256__", sha256),
+        ("__JOB__", job),
+        ("__MAXMIN__", str(int(maxmin))),
+    ):
+        if key not in text:
+            raise ValueError(f"placeholder {key} missing from the template")
+        text = text.replace(key, val)
+    text = text.replace("__CONSOLE_STREAM_PY__", stream_py.rstrip("\n"))
+    if len(text.encode("utf-8")) > USER_DATA_LIMIT:
+        raise ValueError(f"rendered user data is {len(text.encode())} bytes > {USER_DATA_LIMIT}")
+    return text
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Command-line entry point."""
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    b = sub.add_parser("build")
+    b.add_argument("--out", type=Path, default=REPO / "runs" / "aws_bundle")
+    b.add_argument("--v1-dir", type=Path, default=V1_DEFAULT)
+    b.add_argument("--no-v1", action="store_true")
+    b.add_argument("--require-clean", action="store_true")
+    b.add_argument(
+        "--include-untracked",
+        action="store_true",
+        help="also pack untracked files under src/, scenarios/ and data/ (marked in the manifest)",
+    )
+    r = sub.add_parser("render")
+    r.add_argument("--job", required=True, choices=JOBS)
+    r.add_argument("--url", required=True)
+    r.add_argument("--sha256", required=True)
+    r.add_argument("--maxmin", type=int, required=True)
+    r.add_argument("--allow-file-url", action="store_true")
+    r.add_argument("-o", "--output", type=Path, default=None)
+    a = ap.parse_args(argv)
+    if a.cmd == "build":
+        info = build(a.out, None if a.no_v1 else a.v1_dir, a.require_clean, a.include_untracked)
+        print(json.dumps(info, indent=1))
+        if info.get("untracked_not_included"):
+            print(
+                "WARNING: untracked files under src/, scenarios/ or data/ are NOT in the bundle "
+                f"({len(info['untracked_not_included'])}); commit them or pass "
+                "--include-untracked",
+                file=sys.stderr,
+            )
+        if info["sremu_dirty"]:
+            print(
+                "WARNING: the sremu tree is dirty; commit first for a reproducible bundle",
+                file=sys.stderr,
+            )
+        return 0
+    text = render(a.job, a.url, a.sha256, a.maxmin, allow_file_url=a.allow_file_url)
+    if a.output is None:
+        sys.stdout.write(text)
+    else:
+        a.output.write_text(text, encoding="utf-8", newline="\n")
+        print(f"wrote {a.output} ({len(text.encode())} bytes)", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
