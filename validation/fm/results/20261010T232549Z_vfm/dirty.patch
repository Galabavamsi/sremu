+def sensitivity_run(protocol: Mapping[str, Any], run_id: str) -> dict[str, Any]:
+    """The ``sensitivity_runs`` entry with ``id == run_id`` (``KeyError`` if absent)."""
+    for r in protocol.get("sensitivity_runs", []):
+        if str(r["id"]) == run_id:
