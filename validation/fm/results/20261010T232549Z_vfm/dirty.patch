diff --git a/bench/aws/run_job.py b/bench/aws/run_job.py
new file mode 100644
index 0000000000000000000000000000000000000000..d6f0cf1176bd23ec9b813d8c19d18ae987c6aa1b
--- /dev/null
+++ b/bench/aws/run_job.py
@@ -0,0 +1,237 @@
+#!/usr/bin/env python3
+"""Run one AWS benchmark job (called by ``user_data.sh``; stdlib only for the dispatch).
+
+Usage::
+
+    python bench/aws/run_job.py JOB --out OUT [--python PY] [--v1-python PY]
+                                [--budget-min 85] [--dry]
+
+Jobs (each sizes itself to finish within ``--budget-min`` minutes; default 85, so a job
+stays within 90 min on c6i.8xlarge; DESIGN.md sections 12.3, 12.4):
+
+* ``b3_paced``: B3 paced sustainable links and latency CDFs (1 MS/s; page targets 0.25,
+  0.5, 1 ms; L doubled while sustainable; 5 s warm-up, 60 s, 3 repetitions).
+* ``b4_paced``: B4 paced + async control loop (10 Hz-10 kHz; timed and asap; 3 reps).
+* ``b5_v1_vs_sremu``: B5 v1-as-committed (+ the one import fix) vs sremu on this host.
+* ``b2_server_point``: B1 kernels (no engine fit) and B2 lockstep slices S1, S6 (thread
+  scaling), S4, S2 on the server (the "large server" point; budget shared).
+* ``eb3_paced_controller``: the E-B3 timing demonstration (external TDMA controller).
+* ``smoke``: quick versions of B2 (S1, S6), B3 and a short B4 paced run (client
+  pinning); dry runs and bundle checks.
+* ``selftest``: no sremu import; writes ``sysinfo.json`` only (channel tests).
+
+Writes ``OUT/status.json`` (job, commands, exit codes, wall times) and
+``OUT/sysinfo.json`` (uname, CPU, governor, affinity, Python, ``pip freeze``).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import platform
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+SRC = HERE.parents[1]
+JOBS = (
+    "b3_paced",
+    "b4_paced",
+    "b5_v1_vs_sremu",
+    "b2_server_point",
+    "eb3_paced_controller",
+    "smoke",
+    "selftest",
+)
+
+
+def commands(job: str, out: Path, py: str, v1_py: str, budget: float) -> list[list[str]]:
+    """The command lines of a job."""
+    o = ["--out", str(out)]
+    if job == "b3_paced":
+        return [[py, "-m", "bench.b3_paced", "--budget-min", f"{budget:g}", *o]]
+    if job == "b4_paced":
+        return [
+            [py, "-m", "bench.b4_control", "--part", "paced", "--budget-min", f"{budget:g}", *o]
+        ]
+    if job == "b5_v1_vs_sremu":
+        v1 = SRC / "v1_bench"
+        return [
+            [
+                py,
+                "-m",
+                "bench.b5_v1",
+                "--v1-dir",
+                str(v1),
+                "--v1-source",
+                str(v1),
+                "--v1-python",
+                v1_py,
+                *o,
+            ]
+        ]
+    if job == "b2_server_point":
+        return [
+            [py, "-m", "bench.b1_kernels", "--skip-engine", *o],
+            [
+                py,
+                "-m",
+                "bench.b2_lockstep",
+                "--slices",
+                "S1,S6,S4,S2",
+                "--budget-min",
+                f"{max(10.0, budget - 15):g}",
+                *o,
+            ],
+        ]
+    if job == "eb3_paced_controller":
+        return [[py, "-m", "bench.eb3_paced", "--budget-min", f"{budget:g}", *o]]
+    if job == "smoke":
+        return [
+            [py, "-m", "bench.b2_lockstep", "--quick", "--slices", "S1,S6", *o],
+            [py, "-m", "bench.b3_paced", "--quick", *o],
+            [
+                py,
+                "-m",
+                "bench.b4_control",
+                "--part",
+                "paced",
+                "--rates",
+                "100",
+                "--modes",
+                "timed",
+                "--reps",
+                "1",
+                "--warmup-s",
+                "2",
+                "--measure-s",
+                "5",
+                "--tag",
+                "paced_smoke",
+                *o,
+            ],
+        ]
+    if job == "selftest":
+        return []
+    raise SystemExit(f"unknown job {job!r}; one of {', '.join(JOBS)}")
+
+
+def _read(path: str) -> str | None:
+    try:
+        return Path(path).read_text(encoding="utf-8").strip()
+    except OSError:
+        return None
+
+
+def sysinfo(py: str) -> dict[str, object]:
+    """Host facts for the result bundle."""
+    info: dict[str, object] = {
+        "uname": platform.uname()._asdict(),
+        "python_dispatch": sys.version,
+        "nproc": os.cpu_count(),
+        "affinity": sorted(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else None,
+        "governor_cpu0": _read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"),
+        "dmi_product": _read("/sys/devices/virtual/dmi/id/product_name"),
+        "dmi_asset_tag": _read("/sys/devices/virtual/dmi/id/board_asset_tag"),
+        "loadavg": _read("/proc/loadavg"),
+        "env": {
+            k: os.environ.get(k)
+            for k in (
+                "NUMBA_NUM_THREADS",
+                "NUMBA_DISABLE_INTEL_SVML",
+                "SREMU_CPUS",
+                "SREMU_GOVERNOR",
+            )
+        },
+    }
+    try:
+        info["lscpu"] = subprocess.run(["lscpu"], capture_output=True, text=True, timeout=30).stdout
+    except (OSError, subprocess.SubprocessError):
+        info["lscpu"] = None
+    try:
+        info["pip_freeze"] = subprocess.run(
+            [py, "-m", "pip", "freeze"], capture_output=True, text=True, timeout=120
+        ).stdout.splitlines()
+    except (OSError, subprocess.SubprocessError):
+        info["pip_freeze"] = None
+    return info
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Command-line entry point."""
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("job", choices=JOBS)
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--python", default=sys.executable)
+    ap.add_argument(
+        "--v1-python",
+        default=str(Path(sys.executable).parent.parent.parent / "venv_v1" / "bin" / "python"),
+    )
+    ap.add_argument("--budget-min", type=float, default=85.0)
+    ap.add_argument("--dry", action="store_true", help="print the commands only")
+    ap.add_argument(
+        "--grace-s", type=float, default=45.0, help="time a suite gets after SIGINT to finish"
+    )
+    a = ap.parse_args(argv)
+    a.out.mkdir(parents=True, exist_ok=True)
+    cmds = commands(a.job, a.out, a.python, a.v1_python, a.budget_min)
+    if a.dry:
+        print(json.dumps(cmds, indent=1))
+        return 0
+    (a.out / "sysinfo.json").write_text(json.dumps(sysinfo(a.python), indent=1), encoding="utf-8")
+    status: dict[str, object] = {
+        "job": a.job,
+        "commands": cmds,
+        "results": [],
+        "interrupted": False,
+    }
+    results: list[dict[str, object]] = []
+    status["results"] = results
+    t0 = time.time()
+    rc_all = 0
+    for c in cmds:
+        t = time.time()
+        log = a.out / f"{Path(c[2] if len(c) > 2 else 'cmd').name}.log"
+        rc, interrupted = run_child(c, log, grace_s=a.grace_s)
+        results.append(
+            {
+                "cmd": c,
+                "rc": rc,
+                "wall_s": time.time() - t,
+                "log": log.name,
+                "interrupted": interrupted,
+            }
+        )
+        rc_all = rc_all or rc
+        (a.out / "status.json").write_text(json.dumps(status, indent=1), encoding="utf-8")
+        if interrupted:  # the instance's time limit: no further suites
+            status["interrupted"] = True
+            rc_all = rc_all or 130
+            break
+    status["wall_s"] = time.time() - t0
+    status["rc"] = rc_all
+    (a.out / "status.json").write_text(json.dumps(status, indent=1), encoding="utf-8")
+    return rc_all
+
+
+def run_child(cmd: list[str], log: Path, grace_s: float = 45.0) -> tuple[int, bool]:
+    """Run one suite with its output appended to ``log``. On SIGINT (``timeout`` signals the
+    whole process group, so the suite receives it too) wait up to ``grace_s`` for the suite to
+    write its partial run directory before killing it. Returns ``(rc, interrupted)``."""
+    with log.open("ab") as fh:
+        p = subprocess.Popen(cmd, cwd=SRC, stdout=fh, stderr=subprocess.STDOUT)
+        try:
+            return p.wait(), False
+        except KeyboardInterrupt:
+            try:
+                return p.wait(timeout=grace_s), True
+            except subprocess.TimeoutExpired:
+                p.kill()
+                return p.wait(), True
+
+
+if __name__ == "__main__":
+    sys.exit(main())
