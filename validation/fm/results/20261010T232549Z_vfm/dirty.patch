@@ -0,0 +1,241 @@
+"""B3: paced sustainable links and page-latency CDFs (DESIGN.md sections 4.10, 12.1-12.3, F8).
+
+Usage::
+
+    python -m bench.b3_paced [--rates 1e6] [--page-targets 5e-4,1e-3,2.5e-4]
+                             [--links 1,2,4,...] [--reps 3] [--warmup-s 5] [--measure-s 60]
+                             [--budget-min 85] [--quick] [--out DIR]
+
+Scene: the B2 base (N = 240, one panel, F1: LOS + RIS tiles + thermal noise), L links
+(``bench._scenes.split_links``), headless paced run (in-process TX generators; RX pages
+delivered to the engine's RX history; no transport). For each page target and rate, L is
+doubled from 1 while the point is sustainable; the first unsustainable L ends that series.
+The base page target (0.5 ms) runs first, so a budget cut drops the 1 ms and 0.25 ms series.
+
+Per repetition (section 12.3): ``--warmup-s`` warm-up, then ``--measure-s`` measured (the
+pacer's deadline statistics, the RTF meter and the counters restart at the end of the
+warm-up); 3 repetitions per point. **Sustainable** (section 12.1): miss rate < 1e-3 at
+1 ms slack and zero ``late_samples`` and ``overflow_pages`` over the measured window; a
+point is sustainable when every repetition is. Reported: miss rate at slack 0/1/5 ms, page
+latency p50/p99/p99.9/max with the full log-linear histogram (``latency_hist.json``, for
+CCDF plots), utilization, counters, and the largest sustainable L per (rate, page target)
+with the median of medians and the worst p99 (section 12.3).
+
+Paced numbers for the paper come only from Linux; on Windows every output is labelled
+"Windows, not representative". The job sizes itself to ``--budget-min``; points that do
+not fit are listed in ``dropped.csv``. Of the section 12.2 grid only L and the page target
+are swept by default (base N, R, f_s, F1): the other dimensions do not fit one 90-min
+instance job (``--rates`` and ``--n-cells`` select other slices). ``summary.json`` states
+whether the run met the section 12.3 protocol (warm-up >= 5 s, >= 60 s and >= 1e4 pages
+per repetition, >= 3 repetitions); each row carries the background busy fraction sampled
+during its repetition.
+"""
+
+from __future__ import annotations
+
+import argparse
+import statistics
+import sys
+import time
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import bench
+from bench._common import BenchRun
+
+SUITE = "b3"
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run B3 and write its run directory."""
+    bench.deterministic_env()
+    ap = argparse.ArgumentParser(prog="bench.b3_paced", description=__doc__.splitlines()[0])
+    ap.add_argument("--rates", default="1e6")
+    ap.add_argument("--page-targets", default="5e-4,1e-3,2.5e-4")
+    ap.add_argument("--links", default="1,2,4,8,16,32,64,128")
+    ap.add_argument("--n-cells", type=int, default=240)
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--warmup-s", default="5")
+    ap.add_argument("--measure-s", default="60")
+    ap.add_argument("--budget-min", type=float, default=85.0)
+    ap.add_argument("--quick", action="store_true", help="1 rep, 1 s warm-up, 3 s measured")
+    ap.add_argument("--out", type=Path, default=None)
+    ap.add_argument("--tag", default=None)
+    ap.add_argument("--wait-quiet-min", type=float, default=0.0, help="wait for an idle host first")
+    ap.add_argument("--threads", type=int, default=None, help="numba threads (default: all)")
+    a = ap.parse_args(argv)
+    bench.set_threads(a.threads)
+    from bench._engine_point import measure_paced
+    from bench._scenes import bench_scenario
+
+    if a.quick:
+        a.reps, a.warmup_s, a.measure_s = 1, "1", "3"
+        a.links = "1,4"
+        a.page_targets = "5e-4"
+    rates = [r for r in a.rates.split(",") if r]
+    targets = [p for p in a.page_targets.split(",") if p]
+    links = [int(x) for x in a.links.split(",") if x]
+    spec = {
+        "threads": a.threads,
+        "rates_sps": rates,
+        "page_targets_s": targets,
+        "links": links,
+        "n_cells": a.n_cells,
+        "features": "F1",
+        "reps": a.reps,
+        "warmup_s": a.warmup_s,
+        "measure_s": a.measure_s,
+        "budget_min": a.budget_min,
+        "sustainable": (
+            "miss rate < 1e-3 at 1 ms slack, late_samples == 0, overflow_pages == 0, every rep"
+        ),
+    }
+    run = BenchRun(
+        SUITE,
+        spec,
+        out_root=a.out,
+        tag=a.tag or ("quick" if a.quick else None),
+        mode="paced",
+        coupling="barrier",
+        paced=True,
+        caveats=[
+            "Headless paced runs: in-process TX generators, no transport, RX delivered to the "
+            "engine's RX history; client and transport costs are not included.",
+            "Page latency = delivery - release (inputs are always complete in-process).",
+        ],
+        quiet_s=1.0 if a.quick else 3.0,
+        wait_quiet_s=a.wait_quiet_min * 60.0,
+    )
+    t_start = time.perf_counter()
+    budget = a.budget_min * 60.0
+    per_rep = float(Fraction(a.warmup_s) + Fraction(a.measure_s)) + 10.0
+    rows: list[dict[str, Any]] = []
+    hists: dict[str, Any] = {}
+    dropped: list[dict[str, Any]] = []
+    best: dict[str, Any] = {}
+    with run.interruptible():
+        for rate in rates:
+            for pt in targets:
+                key = f"fs{rate}_page{pt}"
+                last_ok = None
+                for L in links:
+                    if time.perf_counter() - t_start + per_rep * a.reps > budget:
+                        dropped.append(
+                            {"rate": rate, "page_target_s": pt, "L": L, "reason": "budget"}
+                        )
+                        continue
+                    reps = []
+                    for rep in range(a.reps):
+                        sc = bench_scenario(
+                            links=L,
+                            n_cells=a.n_cells,
+                            n_ris=1,
+                            rate_sps=rate,
+                            features="F1",
+                            page_target_s=pt,
+                            mode="paced",
+                            duration_s="1",
+                            seed=rep,
+                        )
+                        i_load = run.load.mark()
+                        r = measure_paced(
+                            sc, features="F1", warmup_s=a.warmup_s, measure_s=a.measure_s
+                        )
+                        load = run.load.window_stats(i_load)
+                        pid = f"{key}_L{L}_rep{rep}"
+                        hists[pid] = r.pop("latency_hist_ns")
+                        sha = run.save_scenario(pid, r.pop("resolved"))
+                        lat = r["latency_us"] or {}
+                        row = {
+                            "point_id": pid,
+                            "rate_sps": rate,
+                            "page_target_s": pt,
+                            "L": L,
+                            "rep": rep,
+                            "page": r["facts"]["page"],
+                            "pages": r["pages"],
+                            "measured_s": r["measured_s"],
+                            "warmup_restart_ok": r["warmup_restart_ok"],
+                            "miss_rate_0ms": r["miss_rate"].get("0ms"),
+                            "miss_rate_1ms": r["miss_rate"].get("1ms"),
+                            "miss_rate_5ms": r["miss_rate"].get("5ms"),
+                            "lat_p50_us": lat.get("p50"),
+                            "lat_p99_us": lat.get("p99"),
+                            "lat_p999_us": lat.get("p99.9"),
+                            "lat_max_us": lat.get("max"),
+                            "util_p50": (r["utilization"] or {}).get("p50"),
+                            "util_p99": (r["utilization"] or {}).get("p99"),
+                            "late_samples": r["counters"].get("late_samples"),
+                            "overflow_pages": r["counters"].get("overflow_pages"),
+                            "underflow_slip_samples": r["counters"].get("underflow_slip_samples"),
+                            "rtf": r["rtf"],
+                            "sustainable": r["sustainable"],
+                            "min_ris_minus_los_db": r["ris_check"]["min_ris_minus_los_db"],
+                            "wall_s": r["wall_s"],
+                            "bg_busy_mean": load["mean"],
+                            "bg_busy_max": load["max"],
+                            "scenario_sha256": sha,
+                        }
+                        rows.append(row)
+                        reps.append(row)
+                        run.write_csv("points.csv", rows)
+                        print(
+                            f"{pid}: miss1ms={row['miss_rate_1ms']} p99={row['lat_p99_us']} us "
+                            f"sustainable={row['sustainable']}",
+                            flush=True,
+                        )
+                    ok = all(x["sustainable"] for x in reps)
+                    if ok:
+                        last_ok = {
+                            "L": L,
+                            "median_of_median_latency_us": statistics.median(
+                                x["lat_p50_us"] for x in reps if x["lat_p50_us"] is not None
+                            ),
+                            "worst_p99_latency_us": max(
+                                x["lat_p99_us"] for x in reps if x["lat_p99_us"] is not None
+                            ),
+                            "worst_miss_rate_1ms": max(x["miss_rate_1ms"] for x in reps),
+                            "min_pages_per_rep": min(x["pages"] or 0 for x in reps),
+                            "reps": len(reps),
+                        }
+                    else:
+                        for L2 in links[links.index(L) + 1 :]:
+                            dropped.append(
+                                {
+                                    "rate": rate,
+                                    "page_target_s": pt,
+                                    "L": L2,
+                                    "reason": f"L={L} not sustainable",
+                                }
+                            )
+                        break
+                best[key] = last_ok
+    run.write_json("latency_hist.json", hists)
+    if dropped:
+        run.write_csv("dropped.csv", dropped)
+    pages = [r["pages"] or 0 for r in rows]
+    warm_f, meas_f = float(Fraction(a.warmup_s)), float(Fraction(a.measure_s))
+    summary = {
+        "suite": SUITE,
+        "protocol_12_3": {
+            "warmup_s": warm_f,
+            "measure_s": meas_f,
+            "reps": a.reps,
+            "min_pages_per_rep": min(pages) if pages else None,
+            "meets_12_3": bool(
+                warm_f >= 5 and meas_f >= 60 and a.reps >= 3 and pages and min(pages) >= 10_000
+            ),
+        },
+        "largest_sustainable": best,
+        "points": len(rows),
+        "dropped": len(dropped),
+        "wall_s": time.perf_counter() - t_start,
+    }
+    run.finish(summary)
+    print(f"B3 written to {run.dir}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/b4_control.py b/bench/b4_control.py
new file mode 100644
index 0000000000000000000000000000000000000000..298ad9530878fb682ec98be55a1cf9f38cbd8e5c
--- /dev/null
+++ b/bench/b4_control.py
@@ -0,0 +1,463 @@
+"""B4: control loop timing (DESIGN.md sections 4.9, 12.1, 12.2).
+
+Usage::
+
+    python -m bench.b4_control --part lockstep [--quick] [--out DIR]
+    python -m bench.b4_control --part paced [--rates 10,100,1000,10000] [--reps 3]
+                               [--warmup-s 5] [--measure-s 60] [--out DIR]
+
+Scene: the B2 base scene with L = 4 links (2 TX, 2 RX), N = 240, one panel, 1 MS/s, F1.
+
+**Lockstep part** (laptop): command rate r in {10, 100, 1000, 10000} Hz.
+
+* ``inproc``: WP9's ``Urap(p=0.5)`` registered in-process as a barrier controller with
+  period 1/r and L_min = 0.1 ms (latency L_min + U[0, L_min]);
+* ``remote``: the same controller in a separate process over the control socket
+  (section 8.5 barrier protocol; :mod:`bench._ctl_client` ``barrier``);
+* ``none``: the same scene without a controller (reference RTF).
+
+Reported: commands, statuses, ``lateness_samples`` on every RX (section 4.9: must be 0;
+the suite fails otherwise), RTF with and without the loop, and the lockstep wall-clock
+"visible latency" ``t_wall_visible - t_wall_recv`` (how long the engine took to reach the
+switch sample; not a real-time latency).
+
+**Paced part** (Linux, AWS job ``b4_paced``; on Windows labelled "Windows, not
+representative"): the engine runs paced with async coupling, served over the control
+socket; an external process (:mod:`bench._ctl_client` ``async``) sends one
+``ris.set_config`` every 1/r wall seconds, timed (lead 2 ms) or ``asap``. Per repetition:
+``--warmup-s`` warm-up, then ``--measure-s`` measured (commands issued during the warm-up
+are excluded). Reported: lateness distribution (samples) per RX, command visible latency
+``t_wall_visible - t_wall_recv`` percentiles, statuses, client round-trip percentiles,
+deadline misses and page latency of the paced run.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import statistics
+import subprocess
+import sys
+import time
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import bench
+from bench._common import REPO, BenchRun, percentiles
+
+SUITE = "b4"
+L_MIN = Fraction(1, 10_000)
+RATES = (10, 100, 1000, 10_000)
+
+
+def _scene(
+    duration_s: Fraction, mode: str = "lockstep", coupling: str = "barrier"
+) -> dict[str, Any]:
+    from bench._scenes import bench_scenario
+
+    return bench_scenario(
+        links=4,
+        n_cells=240,
+        n_ris=1,
+        rate_sps="1e6",
+        features="F1",
+        duration_s=str(duration_s),
+        mode=mode,
+        coupling=coupling,
+        name="b4_control",
+    )
+
+
+def _record_stats(recs: list[Any], src: str, t_from: Fraction | None = None) -> dict[str, Any]:
+    mine = [
+        r
+        for r in recs
+        if r.src == src and (t_from is None or (r.t_req is not None and r.t_req >= t_from))
+    ]
+    status: dict[str, int] = {}
+    late: list[int] = []
+    late_by_rx: dict[str, list[int]] = {}
+    vis: list[float] = []
+    for r in mine:
+        status[r.status] = status.get(r.status, 0) + 1
+        for rx, v in (r.lateness_samples or {}).items():
+            late.append(int(v))
+            late_by_rx.setdefault(rx, []).append(int(v))
+        if r.t_wall_visible_ns is not None and r.t_wall_recv_ns is not None:
+            vis.append((r.t_wall_visible_ns - r.t_wall_recv_ns) * 1e-3)
+    return {
+        "commands": len(mine),
+        "status": status,
+        "lateness_samples": percentiles(late, (50, 99, 99.9)) if late else {},
+        "lateness_nonzero": sum(1 for v in late if v != 0),
+        "lateness_max": max(late) if late else None,
+        "lateness_by_rx_max": {k: max(v) for k, v in late_by_rx.items()},
+        "visible_latency_us": percentiles(vis, (50, 90, 99, 99.9)) if vis else {},
+    }
+
+
+# =========================================================================== lockstep
+
+
+def lockstep_point(rate_hz: int, variant: str, duration: Fraction) -> dict[str, Any]:
+    """One lockstep run: ``variant`` in none | inproc | remote."""
+    from bench._engine_point import _resolve, build_engine
+    from bench._scenes import ris_path_check
+    from sremu.contracts import LatencyModel
+    from sremu.control.builtin import Urap
+
+    res = _resolve(_scene(duration))
+    eng = build_engine(res, "F1")
+    chk = ris_path_check(eng.model)
+    n_ctl = eng.commands.specs["ris0"].n_controls
+    out: dict[str, Any] = {"rate_hz": rate_hz, "variant": variant, "virtual_s": float(duration)}
+    t0 = time.perf_counter()
+    if variant == "remote":
+        from sremu.transport.control_server import ControlServer, ServerConfig
+
+        srv = ControlServer(
+            eng,
+            ServerConfig(
+                control_endpoint="tcp://127.0.0.1:0",
+                pub_endpoint=None,
+                tx_endpoint="tcp://127.0.0.1:0",
+                start_paused=True,
+                max_command_rate_hz=1e5,
+            ),
+        ).start()
+        try:
+            cmd = [
+                sys.executable,
+                "-m",
+                "bench._ctl_client",
+                "barrier",
+                "--endpoint",
+                str(srv.endpoints["control"]),
+                "--rate-hz",
+                str(rate_hz),
+                "--l-min",
+                str(L_MIN),
+                "--idle-s",
+                "3",
+            ]
+            p = subprocess.Popen(
+                cmd, cwd=REPO, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
+            )
+            t_run = time.perf_counter()
+            while not srv.is_done():
+                if p.poll() is not None and not srv.is_done():
+                    break
+                time.sleep(0.01)
+            wall = time.perf_counter() - t_run
+            o, e = p.communicate(timeout=120)
+            if srv.engine_error is not None:
+                raise RuntimeError(f"engine error: {srv.engine_error}")
+            out["client"] = (
+                json.loads(o.strip().splitlines()[-1]) if o.strip() else {"stderr": e[-2000:]}
+            )
+        finally:
+            srv.stop()
+        s = eng.summary()
+        # the engine's RTF meter starts at the first computed page (after sim.resume); the
+        # outer wall time also contains the client's start-up while the server is paused
+        out["wall_s_incl_client_start"] = wall
+        out["wall_s"] = s.rtf.get("wall_s")
+        out["rtf"] = s.rtf.get("rtf")
+        out["rtf_engine_meter"] = s.rtf.get("rtf")
+        out["rtf_min"] = s.rtf.get("rtf_min")
+    else:
+        if variant == "inproc":
+            eng.register_controller(
+                Urap(
+                    0.5,
+                    name="b4",
+                    period_s=Fraction(1, rate_hz),
+                    min_latency_s=L_MIN,
+                    latency=LatencyModel(L_MIN, f"uniform:0,{float(L_MIN)!r}"),
+                )
+            )
+        s = eng.run(until_s=duration)
+        out["wall_s"] = time.perf_counter() - t0
+        out["rtf"] = s.rtf.get("rtf")
+        out["rtf_engine_meter"] = s.rtf.get("rtf")
+        out["rtf_min"] = s.rtf.get("rtf_min")
+    out.update(_record_stats(list(eng.records), "b4"))
+    out["n_controls"] = n_ctl
+    out["nondeterministic_inputs"] = eng.nondeterministic_inputs
+    out["min_ris_minus_los_db"] = chk["min_ris_minus_los_db"]
+    out["scenario_sha256"] = res.sha256()
+    eng.close()
+    return out
+
+
+def run_lockstep(run: BenchRun, quick: bool) -> dict[str, Any]:
+    from bench._engine_point import _resolve, prewarm
+
+    prewarm(_resolve(_scene(Fraction(1))), "F1")  # numba kernels hot before any timing
+    rows = []
+    rates = (10, 1000) if quick else RATES
+    with run.interruptible():
+        for rate in rates:
+            n_cmd = 50 if quick else 200
+            duration = max(Fraction(1, 4) if quick else Fraction(1), Fraction(n_cmd, rate))
+            for variant in ("none", "inproc", "remote"):
+                r = lockstep_point(rate, variant, duration)
+                rows.append(r)
+                print(
+                    f"lockstep {variant:6s} {rate:6d} Hz: rtf={r['rtf']:.3f} "
+                    f"commands={r['commands']} late_nonzero={r['lateness_nonzero']} "
+                    f"status={r['status']}",
+                    flush=True,
+                )
+    flat = []
+    for r in rows:
+        flat.append(
+            {
+                k: (json.dumps(v) if isinstance(v, dict) else v)
+                for k, v in r.items()
+                if k not in ("client",)
+            }
+        )
+    run.write_csv("lockstep.csv", flat)
+    run.write_json("lockstep.json", rows)
+    bad = [r for r in rows if r["variant"] != "none" and r["lateness_nonzero"]]
+    return {
+        "lockstep_points": len(rows),
+        "lockstep_all_lateness_zero": not bad,
+        "lockstep_commands_total": sum(r["commands"] for r in rows),
+        "lockstep_rtf": {f"{r['variant']}@{r['rate_hz']}Hz": r["rtf"] for r in rows},
+    }
+
+
+# =========================================================================== paced
+
+
+def paced_point(
+    rate_hz: int, mode: str, warmup_s: Fraction, measure_s: Fraction, rep: int
+) -> dict[str, Any]:
+    """One paced + async repetition with an external command process."""
+    from bench._engine_point import _resolve, _restart_paced_stats, build_engine, prewarm
+    from bench._scenes import ris_path_check
+    from sremu.transport.control_server import ControlServer, ServerConfig
+
+    total = warmup_s + measure_s
+    res = _resolve(_scene(total, mode="paced", coupling="async"))
+    prewarm(res, "F1")
+    eng = build_engine(res, "F1")
+    chk = ris_path_check(eng.model)
+    n_ctl = eng.commands.specs["ris0"].n_controls
+    g = eng.groups[0]
+    state: dict[str, Any] = {}
+    eng.on_page(_restart_paced_stats(eng, int(warmup_s * g.rate), state))
+    srv = ControlServer(
+        eng,
+        ServerConfig(
+            control_endpoint="tcp://127.0.0.1:0",
+            pub_endpoint=None,
+            tx_endpoint="tcp://127.0.0.1:0",
+            start_paused=True,
+            max_command_rate_hz=1e5,
+        ),
+    ).start()
+    try:
+        cmd = [
+            sys.executable,
+            "-m",
+            "bench._ctl_client",
+            "async",
+            "--endpoint",
+            str(srv.endpoints["control"]),
+            "--rate-hz",
+            str(rate_hz),
+            "--duration-s",
+            str(float(total) - 0.5),
+            "--mode",
+            mode,
+            "--lead-s",
+            "2e-3",
+            "--n-controls",
+            str(n_ctl),
+            "--seed",
+            str(rep + 1),
+            "--resume",
+        ]
+        p = subprocess.Popen(
+            cmd, cwd=REPO, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
+        )
+        t0 = time.perf_counter()
+        while not srv.is_done():
+            time.sleep(0.05)
+            if time.perf_counter() - t0 > float(total) * 10 + 300:
+                raise RuntimeError("paced run did not finish")
+        wall = time.perf_counter() - t0
+        o, e = p.communicate(timeout=120)
+        client = json.loads(o.strip().splitlines()[-1]) if o.strip() else {"stderr": e[-2000:]}
+        if srv.engine_error is not None:
+            raise RuntimeError(f"engine error: {srv.engine_error}")
+    finally:
+        srv.stop()
+    s = eng.summary()
+    paced = s.paced or {}
+    stats = _record_stats(list(eng.records), "b4async", t_from=warmup_s)
+    eng.close()
+    return {
+        "rate_hz": rate_hz,
+        "mode": mode,
+        "rep": rep,
+        "warmup_s": float(warmup_s),
+        "measure_s": float(measure_s),
+        "warmup_restart_ok": bool(state.get("done")),
+        "wall_s": wall,
+        **stats,
+        "client": client,
+        "pages": paced.get("pages"),
+        "miss_rate": paced.get("miss_rate"),
+        "page_latency_us": paced.get("latency_us"),
+        "utilization": paced.get("utilization"),
+        "counters": dict(s.counters),
+        "n_controls": n_ctl,
+        "min_ris_minus_los_db": chk["min_ris_minus_los_db"],
+        "scenario_sha256": res.sha256(),
+    }
+
+
+def run_paced(
+    run: BenchRun,
+    rates: list[int],
+    reps: int,
+    warm: Fraction,
+    meas: Fraction,
+    modes: list[str],
+    budget_s: float,
+) -> dict[str, Any]:
+    rows = []
+    dropped = []
+    t_start = time.perf_counter()
+    with run.interruptible():
+        for rate in rates:
+            for mode in modes:
+                for rep in range(reps):
+                    if time.perf_counter() - t_start + float(warm + meas) * 1.2 > budget_s:
+                        dropped.append(
+                            {"rate_hz": rate, "mode": mode, "rep": rep, "reason": "budget"}
+                        )
+                        continue
+                    r = paced_point(rate, mode, warm, meas, rep)
+                    rows.append(r)
+                    print(
+                        f"paced {mode:5s} {rate:6d} Hz rep {rep}: commands={r['commands']} "
+                        f"late p99={r['lateness_samples'].get('p99')} max={r['lateness_max']} "
+                        f"vis p99={r['visible_latency_us'].get('p99')} us miss={r['miss_rate']}",
+                        flush=True,
+                    )
+                    run.write_json("paced.json", rows)
+    flat = [{k: (json.dumps(v) if isinstance(v, dict) else v) for k, v in r.items()} for r in rows]
+    run.write_csv("paced.csv", flat)
+    if dropped:
+        run.write_csv("paced_dropped.csv", dropped)
+    by: dict[str, Any] = {}
+    for rate in rates:
+        for mode in modes:
+            rs = [r for r in rows if r["rate_hz"] == rate and r["mode"] == mode]
+            if not rs:
+                continue
+            p99 = [r["lateness_samples"].get("p99") for r in rs if r["lateness_samples"]]
+            vis = [r["visible_latency_us"].get("p99") for r in rs if r["visible_latency_us"]]
+            by[f"{mode}@{rate}Hz"] = {
+                "reps": len(rs),
+                "lateness_p99_samples_median": statistics.median(p99) if p99 else None,
+                "lateness_max_samples_worst": max((r["lateness_max"] or 0) for r in rs),
+                "visible_latency_p99_us_worst": max(vis) if vis else None,
+                "late_applied_total": sum(r["status"].get("late_applied", 0) for r in rs),
+                "commands_total": sum(r["commands"] for r in rs),
+            }
+    pages = [int(r["pages"] or 0) for r in rows]
+    w, m = float(warm), float(meas)
+    return {
+        "paced": by,
+        "paced_dropped": len(dropped),
+        "protocol_12_3": {
+            "warmup_s": w,
+            "measure_s": m,
+            "reps": reps,
+            "min_pages_per_rep": min(pages) if pages else None,
+            "meets_12_3": bool(w >= 5 and m >= 60 and reps >= 3 and pages and min(pages) >= 10_000),
+        },
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run B4 and write its run directory."""
+    bench.deterministic_env()
+    ap = argparse.ArgumentParser(prog="bench.b4_control", description=__doc__.splitlines()[0])
+    ap.add_argument("--part", choices=("lockstep", "paced"), default="lockstep")
+    ap.add_argument("--quick", action="store_true")
+    ap.add_argument("--rates", default=",".join(str(r) for r in RATES))
+    ap.add_argument("--modes", default="timed,asap")
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--warmup-s", default="5")
+    ap.add_argument("--measure-s", default="60")
+    ap.add_argument("--budget-min", type=float, default=85.0)
+    ap.add_argument("--out", type=Path, default=None)
+    ap.add_argument("--tag", default=None)
+    ap.add_argument("--wait-quiet-min", type=float, default=0.0, help="wait for an idle host first")
+    ap.add_argument("--threads", type=int, default=None, help="numba threads (default: all)")
+    a = ap.parse_args(argv)
+    bench.set_threads(a.threads)
+    paced = a.part == "paced"
+    rates = [int(x) for x in a.rates.split(",") if x]
+    modes = [m for m in a.modes.split(",") if m]
+    spec = {
+        "threads": a.threads,
+        "part": a.part,
+        "quick": a.quick,
+        "scene": "B2 base, L=4 (2 TX x 2 RX), N=240, 1 panel, 1 MS/s, F1",
+        "controller": "Urap(p=0.5), L_min=1e-4 s, latency L_min+U[0,L_min] (lockstep)",
+        "rates_hz": rates if paced else list((10, 1000) if a.quick else RATES),
+        "modes": modes if paced else ["none", "inproc", "remote"],
+        "reps": a.reps if paced else 1,
+        "warmup_s": a.warmup_s if paced else None,
+        "measure_s": a.measure_s if paced else None,
+    }
+    caveats = [
+        "Lockstep 'visible latency' is wall time until the engine computed the switch "
+        "sample; it is not a real-time latency.",
+    ]
+    if paced:
+        caveats.append("Paced numbers are meaningful only on the stated Linux host.")
+    run = BenchRun(
+        SUITE,
+        spec,
+        out_root=a.out,
+        tag=a.tag or (a.part + ("_quick" if a.quick else "")),
+        mode="paced" if paced else "lockstep",
+        coupling="async" if paced else "barrier",
+        paced=paced,
+        caveats=caveats,
+        quiet_s=1.0 if a.quick else 3.0,
+        wait_quiet_s=a.wait_quiet_min * 60.0,
+    )
+    if paced:
+        summary = run_paced(
+            run,
+            rates,
+            a.reps,
+            Fraction(a.warmup_s),
+            Fraction(a.measure_s),
+            modes,
+            a.budget_min * 60.0,
+        )
+    else:
+        summary = run_lockstep(run, a.quick)
+    summary["suite"] = SUITE
+    summary["part"] = a.part
+    run.finish(summary)
+    print(f"B4 written to {run.dir}")
+    if not paced and not summary["lockstep_all_lateness_zero"]:
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/b5_v1.py b/bench/b5_v1.py
