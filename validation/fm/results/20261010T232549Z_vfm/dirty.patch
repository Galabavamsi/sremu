+"""Collect the WP11 results into ``paper/sweeps/results/`` and write ``summary.json``.
+
+    python -m experiments.finalize [--runs runs/wp11]
+
+* ``E-A-IQ/``: VA-1 table from ``<runs>/ea_iq`` (:func:`experiments.ea_iq.aggregate`);
+* ``E-C/``: the E-C run directory (Table VIII data) copied as is;
+* ``E-F/ber/``: BER table (:func:`experiments.ef.aggregate_ber`);
+* ``E-F/latency/``: the latency run directory copied as is;
+* ``summary.json``: the key numbers of every experiment (machine-readable, for the paper
+  pipeline's macros; every value is copied from the result files, nothing is typed).
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import shutil
+import sys
+from pathlib import Path
+from typing import Any
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO) not in sys.path:
+    sys.path.insert(0, str(REPO))
+
+from experiments.common import PAPER, export_git_info, read_json, write_json  # noqa: E402
+
+RESULTS = PAPER / "sweeps" / "results"
+
+
+def _copy_run(src: Path, dst: Path) -> None:
+    if not src.exists():
+        return
+    if dst.exists():
+        shutil.rmtree(dst)
+    shutil.copytree(src, dst, ignore=shutil.ignore_patterns("*.patch", "*.tmp"))
+
+
+def _rows(p: Path) -> list[dict[str, str]]:
+    if not p.exists():
+        return []
+    with p.open(encoding="utf-8", newline="") as fh:
+        return list(csv.DictReader(fh))
+
+
+def summary() -> dict[str, Any]:
+    """Key numbers from the result files."""
+    out: dict[str, Any] = {}
+    hyp = RESULTS / "E-A" / "hypotheses.json"
+    if hyp.exists():
+        h = read_json(hyp)
+        out["E-A"] = {
+            "hypotheses": {k: v for k, v in h.items() if not k.startswith("H-A3_report")},
+            "H-A3_reports": {k: v["decision"] for k, v in h.items() if k.startswith("H-A3_report")},
+            "tau_half": _rows(RESULTS / "E-A" / "tau_half.csv"),
+        }
+    va1 = _rows(RESULTS / "E-A-IQ" / "va1.csv")
+    if va1:
+        out["VA-1"] = {
+            "rows": va1,
+            "all_accept": all(r["accept"] == "True" for r in va1),
+        }
+    va5 = RESULTS / "E-B1" / "va5.json"
+    if va5.exists():
+        out["VA-5"] = read_json(va5)
+    eb2 = _rows(RESULTS / "E-B2" / "eb2_per.csv")
+    if eb2:
+        out["E-B2"] = {
+            "n_points": len(eb2),
+            "f9b_rows_guard_0p5ms": [r for r in eb2 if r["guard_s"] == "1/2000"],
+        }
+    t8 = _rows(RESULTS / "E-C" / "table8.csv")
+    if t8:
+        out["E-C"] = {"table8": t8}
+    ber = _rows(RESULTS / "E-F" / "ber" / "ber.csv")
+    if ber:
+        out["E-F"] = {
+            "ber": ber,
+            "genie_theory_in_ci95_all": all(r["genie_theory_in_ci95"] == "True" for r in ber),
+        }
+    lat = RESULTS / "E-F" / "latency" / "latency.json"
+    if lat.exists():
+        out.setdefault("E-F", {})["latency"] = read_json(lat)
+    return out
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--runs", type=Path, default=REPO / "runs" / "wp11")
+    args = ap.parse_args(argv)
+    runs = args.runs.resolve()
+    export_git_info(runs)  # git state read once; a dirty patch goes to runs/, not the paper repo
+    if (runs / "ea_iq").exists():
+        from experiments import ea_iq
+
+        ea_iq.aggregate(runs / "ea_iq", RESULTS / "E-A-IQ")
+    _copy_run(runs / "ec", RESULTS / "E-C")
+    if (runs / "ef_ber").exists():
+        from experiments import ef
+
+        ef.aggregate_ber(runs / "ef_ber", RESULTS / "E-F" / "ber")
+    _copy_run(runs / "ef_latency", RESULTS / "E-F" / "latency")
+    s = summary()
+    write_json(RESULTS / "summary.json", s)
+    print(json.dumps({k: list(v) if isinstance(v, dict) else v for k, v in s.items()}, default=str)[:2000])
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/experiments/run_sweeps.py b/experiments/run_sweeps.py
new file mode 100644
index 0000000000000000000000000000000000000000..8abe2a3901d0c76e3b7cfa609905b53e1b1de51c
--- /dev/null
+++ b/experiments/run_sweeps.py
@@ -0,0 +1,129 @@
+"""Drive the WP11 sweeps with the sremu sweep runner (``sremu.experiments.sweep``).
+
+    python -m experiments.run_sweeps ea   [--jobs 12] [--out runs/wp11] [--resume]
+    python -m experiments.run_sweeps eb1  [...]
+    python -m experiments.run_sweeps eb2  [...]
+
+Run from the sremu repository root with the sremu venv. For each experiment: the git state
+is read once (``dirty.patch`` written into the output root when the tree is dirty; every
+point manifest carries its hash), shared caches are prebuilt, every sweep spec of
+``paper/sweeps/`` is run with ``--jobs`` worker processes (one run directory per point),
+then the aggregation writes ``paper/sweeps/results/<experiment>/`` (CSV/JSON, meta.json,
+manifest.json).
+"""
+
+from __future__ import annotations
+
+import argparse
+import concurrent.futures as cf
+import sys
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO) not in sys.path:
+    sys.path.insert(0, str(REPO))
+
+from experiments.common import PAPER, export_git_info  # noqa: E402
+from sremu.experiments.sweep import load_spec, run_sweep  # noqa: E402
+
+SPECS = {
+    "ea": ["ea_ref.yaml", "ea_tau.yaml"],
+    "eb1": ["eb1.yaml"],
+    "eb2": ["eb2_lab.yaml", "eb2_ideal1.yaml"],
+}
+RESULTS = PAPER / "sweeps" / "results"
+
+
+def _prebuild_ea(out: Path, jobs: int, spec_paths: list[Path]) -> None:
+    from experiments import ea
+
+    cache = out / "_ea_cache"
+    geos: list[tuple[float, float, float]] = []
+    for sp in spec_paths:
+        for pt in load_spec(sp).points():
+            g = (
+                float(pt.params["fc_hz"]),
+                float(pt.params["h_m"]),
+                float(pt.params.get("loss_db") or 0),
+            )
+            if g not in geos:
+                geos.append(g)
+    with cf.ProcessPoolExecutor(max_workers=max(1, min(jobs, len(geos)))) as pool:
+        futs = [pool.submit(ea.prebuild, fc, h, lp, cache) for fc, h, lp in geos]
+        futs.append(
+            pool.submit(ea.build_trajectory, ea.corridor_scenario(1e9, 2, 20), 33_334.0, cache)
+        )
+        for f in cf.as_completed(futs):
+            r = f.result()
+            print("prebuilt", r if isinstance(r, str) else "trajectory", flush=True)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("experiment", choices=sorted(SPECS))
+    ap.add_argument("--jobs", "-j", type=int, default=12)
+    ap.add_argument("--out", type=Path, default=REPO / "runs" / "wp11")
+    ap.add_argument("--resume", action="store_true")
+    ap.add_argument("--only", default=None, help="run only this spec file name")
+    ap.add_argument("--no-aggregate", action="store_true")
+    ap.add_argument("--spec-dir", type=Path, default=PAPER / "sweeps", help="sweep spec directory")
+    ap.add_argument("--results", type=Path, default=RESULTS, help="aggregated results root")
+    args = ap.parse_args(argv)
+    out: Path = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    info = export_git_info(out)
+    print(
+        f"git {info['commit']} dirty={info['dirty']} patch={info['dirty_patch_sha256']}", flush=True
+    )
+    if args.experiment == "ea":
+        _prebuild_ea(out, args.jobs, [args.spec_dir / n for n in SPECS["ea"]])
+    roots = []
+    for name in SPECS[args.experiment]:
+        if args.only and name != args.only:
+            continue
+        spec = load_spec(args.spec_dir / name)
+        t0 = time.perf_counter()
+
+        def progress(rec: dict) -> None:
+            err = f" {rec.get('error')}" if rec["status"] != "ok" else ""
+            print(
+                f"[{spec.name}] {rec['point_id']} {rec['status']} {rec.get('wall_s', 0):.1f}s{err}",
+                flush=True,
+            )
+
+        res = run_sweep(
+            spec,
+            out,
+            jobs=args.jobs,
+            resume=args.resume,
+            allow_import=True,
+            progress=progress,
+            argv=sys.argv,
+        )
+        print(
+            f"[{spec.name}] {res.n_ok} ok, {res.n_failed} failed, {res.n_resumed} resumed in "
+            f"{time.perf_counter() - t0:.0f} s",
+            flush=True,
+        )
+        roots.append(res.root)
+    if args.no_aggregate or args.only:
+        return 0
+    if args.experiment == "ea":
+        from experiments import ea
+
+        hyp = ea.aggregate([out / "ea_ref", out / "ea_tau"], args.results / "E-A")
+        print(hyp, flush=True)
+    elif args.experiment == "eb1":
+        from experiments import eb_aggregate
+
+        eb_aggregate.aggregate_eb1(out / "eb1", args.results / "E-B1")
+    elif args.experiment == "eb2":
+        from experiments import eb_aggregate
+
+        eb_aggregate.aggregate_eb2([out / "eb2_lab", out / "eb2_ideal1"], args.results / "E-B2")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scenarios/studies/ea_corridor.yaml b/scenarios/studies/ea_corridor.yaml
