# Source and docs: normalize to LF in the repository.
* text=auto eol=lf
# CSV and JSON are always text with LF (DESIGN.md 2.2) ...
*.csv text eol=lf
*.json text eol=lf
# ... except hash-pinned data, which must stay byte-exact: no line-ending conversion at all.
# (These lines come after the *.csv / *.json rules so that they win for these paths.)
data/validation/** -text
tests/golden/** -text
*.sigmf-data binary
*.npz binary
*.parquet binary
*.pdf binary
*.png binary
